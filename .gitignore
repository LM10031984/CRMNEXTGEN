dist/
build/
out/

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Prisma
packages/db/prisma/migrations/dev.db*

# Données sensibles RGPD — snapshots de production (apprenants, SIRET, n° SS, etc.)
