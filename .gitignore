packages/db/airtable-snapshot/
*.xlsx

# Tests
coverage/
playwright-report/
test-results/

# TypeScript incremental build artifacts (packages only — apps/web is intentionally tracked)
packages/*/tsconfig.tsbuildinfo

# Python (doc-engine)
__pycache__/
*.pyc
.venv/
venv/

# Uploaded user data (palier 1: stays out of git)
data/uploads/

# GSD planning — registre de décision du projet, VERSIONNÉ depuis 2026-06-10
# (leçon session cloud 9.3 : contrats/décisions/plans doivent survivre au poste local).
# Seuls les artefacts jetables restent ignorés :
.planning/**/*.tmp
.planning/**/*.local.md
