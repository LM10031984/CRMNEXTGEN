// QualiOF — Prisma schema (MVP enrichi)
// Stack figée : PostgreSQL 16 + Prisma 5
// Convention : enums en MAJUSCULES, tables en PascalCase, champs en camelCase
// Référence : files/MVP-SPEC.md §4 + plan complémentaire (paliers + Airtable Refonte)
// Le modèle reprend la richesse de la base Airtable "BDD Start Academy Refonte" pour
// couvrir : pilotage CA, planning formateurs, pipeline leads, factures, workflow OPCO,
// référentiel Qualiopi par indicateur, RGPD (données sensibles séparées).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // directUrl utilisé par `prisma migrate` (session mode, port 5432) car le
  // pooler transaction mode (DATABASE_URL port 6543) ne supporte pas les
  // prepared statements requises par les migrations Prisma. En local Docker
  // sans pooler, DIRECT_URL = DATABASE_URL → no-op. Sur Supabase prod, les 2
  // URLs sont distinctes (cf .env.local migration cloud).
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, uuid_ossp(map: "uuid-ossp"), pg_trgm, unaccent]
}

// =====================================================
// === Tenant & Auth (Lucia v3)
// =====================================================

model Tenant {
  id                         String            @id @default(uuid())
  name                       String
  siret                      String?
  numDA                      String?
  rcs                        String?
  // Phase 7 — paramètres OF éditables (SET-01/02/03). Toutes nullables :
  // null = fallback ENV (D-01 hybrid BDD/ENV). Première sauvegarde fait basculer
  // la source de vérité en BDD.
  legalForm                  String? // forme juridique libre (SAS, EURL, ...) — voir enum LegalForm pour valeurs canoniques
  legalMentions              String?           @db.Text
  address                    Json?
  invoicePrefix              String?           @default("FAC")
  // Phase 11 — Avoirs + Relances (D-02, D-10).
  // creditNotePrefix : préfixe séquence avoirs (AVO-NNNNNN), distinct de FAC- (CGI art. 289).
  // invoiceReminderDays : array Postgres Int[] des seuils J+N pour relances impayés (1-3 valeurs croissantes).
  creditNotePrefix           String?           @default("AVO")
  invoiceReminderDays        Int[]             @default([30, 45])
  // BUG-15 — Documents légaux statiques tenant (Qualiopi indic 9 — info
  // déroulement prestation, et indic 1 — info site internet).
  // Stockés en markdown, rendus en PDF via marked + paged footer.
  cgvMarkdown                String?           @db.Text
  reglementInterieurMarkdown String?           @db.Text
  iban                       String?
  bic                        String?
  emailFrom                  String?
  logoPath                   String? // ex "/of-assets/{tenantId}/logo.png"
  signaturePedagoPath        String?
  signatureDirigeantPath     String?
  // Phase 9 — Distribution leads automatique (LEAD-01 D-06).
  // Par défaut true pour rétro-compat (les tenants existants gardent le comportement actuel).
  autoAssignLeads            Boolean           @default(true)
  notifyOnLeadAssignEmail    Boolean           @default(true)
  notifyOnLeadAssignBell     Boolean           @default(true)
  // ── Facturation électronique (spec 02/09/2026) ───────────────────────
  /// "SUPERPDP" | "IOPOLE" | "MOCK". Null = aucune plateforme raccordée.
  einvoiceProvider           String?
  /// Feature flag : tant qu'il est faux, RIEN n'est visible dans l'UI et
  /// rien ne part vers une plateforme. On n'expose pas une promesse non tenue.
  einvoiceEnabled            Boolean           @default(false)
  /// SIREN émetteur (dérivable du SIRET, mais figé explicitement : c'est
  /// l'identifiant d'annuaire, il ne se déduit pas au moment de l'envoi).
  siren                      String?
  /// Mention d'exonération portée par chaque ligne de facture.
  /// Défaut applicatif : MENTION_TVA de `lib/catalogue-constants.ts`.
  vatExemptionText           String?           @db.Text
  /// Curseur de synchronisation : plus grand `invoice_event.id` déjà lu chez
  /// la plateforme. Super PDP n'expose AUCUN webhook (doc lue le 03/09) — le
  /// suivi se fait par polling `starting_after_id`, et la séquence est
  /// garantie strictement croissante : repartir de ce maximum ne peut pas
  /// laisser de trou. Stocké en texte parce que les ids sont des int64, que
  /// `Number` ne représente pas fidèlement au-delà de 2^53.
  einvoiceLastEventId        String?
  users                      User[]
  notifications              Notification[]
  regulatoryWatches          RegulatoryWatch[]
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @default(now()) @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
  FORMATEUR
  COMMERCIAL
  COMPTABLE
  LECTEUR
}

model User {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String           @unique
  hashedPwd     String
  firstName     String
  lastName      String
  role          UserRole         @default(LECTEUR)
  // Phase 8 — soft-delete + métadonnées invitation (D-03 CONTEXT.md)
  disabledAt    DateTime? // null = actif. Si !null → validateRequest rejette + sessions invalidées
  lastLoginAt   DateTime? // mis à jour dans loginAction sur succès
  invitedAt     DateTime? // null = créé manuellement (seed)
  invitedBy     String? // FK User.id de l'admin (pas de Prisma relation pour éviter cycle)
  invitations   UserInvitation[] @relation("UserInvitations")
  authSessions  AuthSession[]
  auditLogs     AuditLog[]
  leadsOwned    Lead[]
  tasksOwned    Task[]
  notifications Notification[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId])
  @@index([tenantId, disabledAt])
}

model AuthSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

/// Phase 8 — Invitation tokenisée pour création de mot de passe (D-04 CONTEXT.md).
/// Token clair (random 32 hex) exposé dans l'URL `/invitation/{token}`. Pas hashé en BDD
/// car single-use + expiration 7j + 128 bits d'entropie suffisent (RESEARCH Finding #4).
model UserInvitation {
  id        String    @id @default(uuid())
  tenantId  String
  email     String
  token     String    @unique // random 32 hex, exposé dans URL — pas hashé (cf RESEARCH Finding #4)
  role      UserRole
  expiresAt DateTime // J+7 par défaut
  usedAt    DateTime? // null = pas encore utilisée
  userId    String?
  user      User?     @relation("UserInvitations", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy String // FK User.id de l'admin qui a déclenché l'invitation
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@index([token])
  @@index([email, tenantId])
}

// =====================================================
// === CŒUR : résolution du cas EI / multi-casquettes
// =====================================================

model Person {
  id                     String                @id @default(uuid())
  tenantId               String
  civility               String?
  firstName              String
  lastName               String
  birthName              String?
  birthDate              DateTime?
  email                  String?
  phone                  String?
  personalAddress        Json?
  educationLevel         String?
  diplomas               String? // texte libre depuis Airtable.Diplômes / SmartOF
  professionalExperience String? // "1-3 ans", "4 ans", "10 ans", "Plus de 10 ans"
  professionalStatus     String? // "Agent commercial", "Conseiller commercial", etc.
  // Documents stockés en MinIO (uploadés au wizard de création apprenant)
  ribKey                 String? // RIB scanné (PDF/image) en MinIO
  bpfDefaultStatus       String?
  rgpdConsentAt          DateTime?
  requiresCleanup        Boolean               @default(false)
  cleanupNotes           String?
  archived               Boolean               @default(false)
  // Relations
  legalLinks             LegalLink[]
  participations         SessionParticipant[]
  trainerSessions        SessionTrainer[]
  attendances            Attendance[]
  trainerAvailabilities  TrainerAvailability[]
  sensitiveData          SensitiveData?
  contactRoles           Contact[] // un Person peut être référencé comme Contact d'organisations
  leadsAsPerson          Lead[]                @relation("LeadPerson")
  comments               InternalComment[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, email])
}

// 1:1 Person — données sensibles RGPD séparées (n° SS, pièce d'identité)
// Reprend le concept de la table Airtable "DONNÉES_SENSIBLES"
model SensitiveData {
  id               String    @id @default(uuid())
  personId         String    @unique
  person           Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  socialSecurityNb String?
  idDocumentUrl    String? // pièce d'identité scannée (MinIO)
  idDocumentType   String? // "CNI", "Passeport", "Titre séjour"
  verifiedAt       DateTime?
  verifiedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Organization {
  id                      String               @id @default(uuid())
  tenantId                String
  legalName               String
  legalForm               LegalForm
  siren                   String?
  siret                   String?
  naf                     String?
  vatNumber               String?
  address                 Json?
  phone                   String?
  email                   String?
  emailBilling            String? // adresse email facturation (souvent ≠ email général)
  phoneBilling            String?
  opcoCode                String? // ex : "AGEFICE", "ATLAS", "OPCO_EP", "CPF"
  opcoCatalogId           String?
  opcoCatalog             OpcoCatalog?         @relation(fields: [opcoCatalogId], references: [id])
  network                 String? // "Orpi", "Century 21", "Keller Williams", indé
  brandName               String? // enseigne / nom commercial
  representative          String?
  activityDescription     String?
  rcs                     String?
  type                    String? // "Client", "Partenaire", "Sous-traitant"
  archived                Boolean              @default(false)
  requiresCleanup         Boolean              @default(false)
  cleanupNotes            String?
  // Relations
  legalLinks              LegalLink[]
  sponsoredParticipations SessionParticipant[]
  billingProfiles         BillingProfile[]
  ageficeProfile          AgeficeProfile?
  contacts                Contact[]
  leadsAsOrg              Lead[]               @relation("LeadOrg")
  invoices                Invoice[]
  comments                InternalComment[]
  opcoSubmissions         OpcoSubmission[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([tenantId, legalName])
  @@index([tenantId, siren])
  @@index([tenantId, siret])
}

enum LegalForm {
  SAS
  SARL
  SASU
  EURL
  SA
  EI
  EIRL
  AUTO_ENTREPRENEUR
  ASSOCIATION
  PARTICULIER
  AUTRE
}

enum LinkRole {
  DIRIGEANT
  SALARIE
  EI_SELF
  AGENT_COMMERCIAL // pattern récurrent immobilier : indépendant rattaché à une enseigne (C21, Magrey, Orpi…)
  ALTERNANT
  STAGIAIRE
  CONTACT
  FINANCEUR_CONTACT
  FORMATEUR
}

model LegalLink {
  id             String       @id @default(uuid())
  personId       String
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           LinkRole
  function       String?
  startDate      DateTime?
  endDate        DateTime?
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([personId, organizationId, role])
  @@index([organizationId])
}

// Contact rattaché à une Organization (= "Contacts_rattachés" dans Airtable Structures)
// Différent d'un Person apprenant : ici c'est juste un interlocuteur dans l'entreprise.
// Souvent c'est un dirigeant RH, un responsable formation, un comptable.
model Contact {
  id               String       @id @default(uuid())
  tenantId         String
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personId         String? // si lié à un Person existant (ex : le contact est aussi apprenant)
  person           Person?      @relation(fields: [personId], references: [id])
  firstName        String
  lastName         String
  email            String?
  phone            String?
  function         String?
  isBillingContact Boolean      @default(false)
  isPrimary        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
}

model BillingProfile {
  id             String               @id @default(uuid())
  tenantId       String
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  invoiceName    String
  address        Json
  legalMentions  String?
  paymentMethod  String?
  participants   SessionParticipant[]
  invoices       Invoice[]
  createdAt      DateTime             @default(now())

  @@index([tenantId])
}

// =====================================================
// === Catalogue de formation
// =====================================================

enum Modality {
  PRESENTIEL
  DISTANCIEL
  MIXTE
  ELEARNING
}

model TrainingProduct {
  id                   String            @id @default(uuid())
  tenantId             String
  code                 String
  title                String
  durationHours        Int
  modality             Modality
  prerequisites        String?
  targetAudience       String?
  objectives           Json // string[]
  programMd            String
  // quick 260618-rkj — Corps figé du déroulé pédagogique (jours[]) — identique sur
  // toutes les sessions du produit. Seul le bilan/rapport formateur reste par session.
  // NB prod : poussé via `prisma db push` en local/sandbox ; un `prisma migrate deploy`
  // formel sera requis avant déploiement cloud (cf. mémoire feedback_prisma_migrate_deploy).
  derouleJson          Json?
  pedagogicalMethods   String?
  evaluationMethods    String?
  accessibility        String?
  trainerProfile       String?
  pedagogicalSupport   String?
  accessConditions     String?
  priceHT              Decimal           @default(0) @db.Decimal(10, 2)
  vatRate              Decimal           @default(0) @db.Decimal(5, 2)
  groupFlatPrice       Decimal?          @db.Decimal(10, 2) // Tarif_forfait_groupe
  theme                String? // "Acquisition", "Stratégie", "Management", "IA", etc.
  version              Int               @default(1)
  isActive             Boolean           @default(true)
  excludedFromBpf      Boolean           @default(false)
  bpfSpecialty         String?
  bpfCategory          String?
  bpfLevel             String?
  capacityMin          Int               @default(1)
  capacityMax          Int               @default(12)
  // ── Conformité Cerfa AGEFICE (Section C/D) ─────────────────────────────
  // Valeurs unions définies dans `lib/agefice-form-fill.ts` (FormationType,
  // FormationNiveau, FormationCertif, AttestationType, EvaluationType).
  // String? côté BDD pour souplesse : si null → fallback default dans le
  // mapping agefice-generator (cohérent avec V1 hardcodée).
  ageficeFormationType String? // ACTION | BILAN | VAE — default ACTION
  ageficeNiveau        String? // INITIATION | MISE_A_JOUR | PERFECTIONNEMENT — default PERFECTIONNEMENT
  ageficeCertif        String? // TITRE_HOMOLOGUE | QUALIF_BRANCHE | CQP | SANS_QUALIFICATION — default SANS_QUALIFICATION
  ageficeAttestation   String? // RNCP | AUTRE_DIPLOME | DIPLOME_ETAT | ATTESTATION_STAGE — default ATTESTATION_STAGE
  /// Cases à cocher Cerfa "Évaluation" — array Postgres. Valeurs : QUIZ,
  /// CONTROLE_CONTINU, RELEVES, FEUILLES_PRESENCE, AUTRE. Si vide → default
  /// ['QUIZ', 'FEUILLES_PRESENCE'].
  ageficeEvaluations   String[]
  ageficeObligatoire   Boolean? // null = aucune case cochée (cohérent avec PDF)
  ageficeReconversion  Boolean?
  ageficeEnEntreprise  Boolean? // formation chez le client final = true
  ageficeMandat        Boolean? // délégation gestion AGEFICE par stagiaire — default true
  // BUG-P0-02 — quand le produit a été auto-rempli par l'IA (createProduct
  // avec autoFillWithAI=true), on horodate ici. Tant que non-null, le
  // contenu est considéré "Brouillon IA" → bannière dans le tab Programme,
  // blocker `product_ai_unreviewed` dans getSessionCompleteness, action
  // "Valider" (set null) ou "Réviser" (édition manuelle = set null aussi).
  aiDraftedAt          DateTime?
  modules              TrainingModule[]
  trainingSessions     TrainingSession[]
  leads                Lead[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model TrainingModule {
  id                        String          @id @default(uuid())
  productId                 String
  product                   TrainingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  order                     Int
  title                     String
  contentMd                 String
  durationMin               Int
  presentielIndividualHours Int?
  presentielCollectifHours  Int?
  distancielSyncHours       Int?
  distancielAsyncHours      Int?

  @@index([productId, order])
}

// =====================================================
// === Sessions
// =====================================================

enum SessionStatus {
  DRAFT
  PLANNED
  OPEN // "Ouverte" dans Airtable, prête à recevoir des inscrits
  VALIDATED
  IN_PROGRESS
  COMPLETED // "Terminée"
  CANCELLED
}

model TrainingSession {
  id                    String                @id @default(uuid())
  tenantId              String
  productId             String
  product               TrainingProduct       @relation(fields: [productId], references: [id])
  code                  String                @unique
  name                  String? // Nom session = "Cycle complet de prospection (87h) - 21/10/2024 -"
  status                SessionStatus         @default(DRAFT)
  startDate             DateTime
  endDate               DateTime
  locationId            String?
  location              Location?             @relation(fields: [locationId], references: [id])
  modality              Modality
  capacityMin           Int                   @default(1)
  capacityMax           Int                   @default(12)
  language              String                @default("fr")
  internalNotes         String?
  // Tarification spécifique session (sinon hérite produit)
  pricePerLearner       Decimal?              @db.Decimal(10, 2)
  // Hébergement formateur (utilisé dans la check-list C4.i17 Qualiopi).
  // Saisi à la création de session ou lors du "Préparer la formation".
  needsTrainerLodging   Boolean               @default(false)
  trainerLodgingPlace   String?
  trainerLodgingDates   String? // Format libre "Du JJ/MM au JJ/MM" — saisi à la main
  // Accessibilité (PSH) pour la check-list — détail + adaptations à prévoir
  hasDisabledLearner    Boolean               @default(false)
  disabilityAdaptations String?
  // Suivi commercial
  preEnrollmentsFromMls Int                   @default(0) // NB_pre_inscription Airtable
  // Lien public d'inscription (spec 2026-08-28). publicToken null = jamais
  // ouvert ; publicFormClosedAt non null = fermé. Régénérer le jeton invalide
  // l'ancien lien immédiatement.
  publicToken           String?               @unique
  publicFormOpenedAt    DateTime?
  publicFormClosedAt    DateTime?
  // Relations
  participants          SessionParticipant[]
  trainers              SessionTrainer[]
  slots                 SessionSlot[]
  documents             Document[]
  pedagogicalAssets     PedagogicalAsset[]
  leads                 Lead[]
  preEnrollments        PreEnrollment[]
  tasks                 Task[]
  comments              InternalComment[]
  calendarSyncs         SessionCalendarSync[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, startDate])
}

model Location {
  id        String            @id @default(uuid())
  tenantId  String
  name      String
  /// Raison sociale du lieu — ex : "SARL XYZ" si la formation se tient dans
  /// l'agence d'un partenaire. Optionnel : laissé vide pour les salles propres.
  /// Utilisé dans la convention de formation et la demande AGEFICE
  /// (concaténé "{legalName} — {name}, adresse").
  legalName String?
  address   Json
  capacity  Int?
  sessions  TrainingSession[]
}

model SessionTrainer {
  id        String          @id @default(uuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  personId  String
  person    Person          @relation(fields: [personId], references: [id])
  role      String
  dailyRate Decimal?        @db.Decimal(10, 2)
  /// Formateur principal de la session — c'est lui qui apparaît comme
  /// signataire sur tous les documents Qualiopi (convention, grille, satisfaction…).
  /// 1 seul `isPrimary=true` par session ; les autres sont co-formateurs.
  isPrimary Boolean         @default(false)

  @@unique([sessionId, personId])
  @@index([sessionId, isPrimary])
}

model SessionSlot {
  id          String          @id @default(uuid())
  sessionId   String
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  date        DateTime
  startTime   String
  endTime     String
  halfDay     String // "morning" | "afternoon" | "full"
  attendances Attendance[]

  @@index([sessionId, date])
}

// Disponibilités déclarées par les formateurs (= "Disponibilites_formateurs" Airtable)
// Sert au planning et à la suggestion automatique de créneaux.
model TrainerAvailability {
  id        String   @id @default(uuid())
  tenantId  String
  trainerId String
  trainer   Person   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("available") // "available" | "busy" | "tentative"
  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId, trainerId, startsAt])
}

// =====================================================
// === Inscriptions (table riche, alignée sur Airtable Refonte)
// =====================================================

enum EnrollmentStatus {
  PRE_ENROLLED
  CONFIRMED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum FinancingMode {
  OPCO
  CPF
  ENTREPRISE // l'entreprise paye directement
  AUTOFINANCEMENT // l'apprenant paye lui-même
  POLE_EMPLOI
  AUTRE
}

enum FinancingStatus {
  NOT_STARTED
  REQUESTED // dossier déposé
  PRE_APPROVED // pré-accord OPCO reçu
  APPROVED // dossier validé
  REJECTED
  REIMBURSED // remboursement reçu
}

enum BillingType {
  STRUCTURE // facturation à l'entreprise
  PERSONNE // facturation au particulier
  OPCO_DIRECT // tiers payeur OPCO
  CPF // financement CPF
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WRITE_OFF
}

/// US-008 : distingue les vraies inscriptions formation des dossiers de
/// "pré-inscription budget" — réservation d'un budget OPCO sans formation
/// définitivement planifiée (ex: dépôt AGEFICE en décembre pour budget 2026).
enum DossierType {
  FORMATION
  PREINSCRIPTION_BUDGET
}

model SessionParticipant {
  id               String          @id @default(uuid())
  sessionId        String
  session          TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  personId         String
  person           Person          @relation(fields: [personId], references: [id])
  // 👇 LE point de pivot. C'est CETTE org qui paye et qui apparaît sur la convention.
  sponsorOrgId     String
  sponsorOrg       Organization    @relation(fields: [sponsorOrgId], references: [id])
  billingProfileId String?
  billingProfile   BillingProfile? @relation(fields: [billingProfileId], references: [id])

  // Tarification
  priceHT         Decimal @default(0) @db.Decimal(10, 2)
  amountCollected Decimal @default(0) @db.Decimal(10, 2)
  amountRemaining Decimal @default(0) @db.Decimal(10, 2)

  // Statuts
  enrollmentStatus EnrollmentStatus @default(PRE_ENROLLED)
  bpfStatus        String?
  participantType  String? // "Salarié", "Dirigeant", "EI"
  payerOrgId       String? // si différent du sponsorOrg (rare mais possible)
  payerContactId   String? // contact destinataire de la facturation

  // Workflow financement
  financingMode         FinancingMode?
  financingStatus       FinancingStatus @default(NOT_STARTED)
  financingRefNumber    String? // référence dossier OPCO
  financingRequestDate  DateTime?
  financingApprovalDate DateTime?

  // Workflow facturation
  billingType   BillingType?
  paymentStatus PaymentStatus @default(PENDING)

  // Checklist Qualiopi (booleans calqués sur Airtable Inscriptions)
  conventionSigned         Boolean @default(false)
  programmeDelivered       Boolean @default(false)
  certificateDelivered     Boolean @default(false)
  pedagogicalSupportsGiven Boolean @default(false)
  attendanceSheetCollected Boolean @default(false)
  assiduitySheetCollected  Boolean @default(false)
  evaluationCollected      Boolean @default(false)
  satisfactionCollected    Boolean @default(false)
  closingDocsSent          Boolean @default(false)

  // Statuts trésorerie OPCO (calqués sur le suivi Excel "Tréso AGEFICE" de
  // Start Academy — source de vérité encaissement, SmartOF étant faux).
  // 4 booléens linéaires : facture émise → validation organisme → remboursement
  // OPCO → paiement effectif du client (= AGEFICE rembourse l'apprenant, puis
  // l'apprenant paye Start Academy).
  factureEnvoyee    Boolean   @default(false)
  validationOpco    Boolean   @default(false)
  remboursementOpco Boolean   @default(false)
  paiementClient    Boolean   @default(false)
  invoiceSent       Boolean   @default(false)
  paymentReceived   Boolean   @default(false)
  // Dates de transition false→true (calcul DSO et delais OPCO)
  invoiceSentAt     DateTime?
  paymentReceivedAt DateTime?
  opcoApprovedAt    DateTime?
  opcoReimbursedAt  DateTime?
  opcoPreApproved   Boolean   @default(false)
  opcoApproved      Boolean   @default(false)
  opcoReimbursed    Boolean   @default(false)

  // US-008 : type de dossier — par défaut une vraie inscription formation,
  // peut être basculé en "réservation budget" pour les dossiers déposés
  // sans formation définitivement calée (ex: AGEFICE budget annuel).
  dossierType DossierType @default(FORMATION)

  // Erreur de cohérence détectée (= "Erreur_payeur" dans Airtable)
  payerErrorMessage String?
  internalNotes     String?

  // Phase 9.1 — Centralisation Qualiopi 360°.
  // Map: { [docType: DocType string]: { state, uploadedSignedPdfKey?, ... } }
  // Voir packages/shared/src/schemas/qualiopi-matrix.ts pour la shape exacte.
  // Source de vérité des statuts manuels par-participant (Bug P0 résolu :
  // 1 PDF Programme stocké session-wide via Document.entityType='product',
  // N statuts par-participant dérivés ici).
  // Les booléens legacy (conventionSigned, programmeDelivered, ...) restent
  // pour rétrocompat — shadowed quand docStatus[type] est présent.
  docStatus Json?

  // Relations
  invoices        Invoice[]
  comments        InternalComment[]
  tasks           Task[]
  agreementDocs   Document[] // les documents Qualiopi rattachés à cette inscription
  opcoSubmissions OpcoSubmission[] // dossiers OPCO envoyés au financeur

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, personId])
  @@index([sponsorOrgId])
  @@index([financingStatus])
  @@index([paymentStatus])
  @@index([dossierType])
}

model Attendance {
  id           String      @id @default(uuid())
  slotId       String
  slot         SessionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  personId     String
  person       Person      @relation(fields: [personId], references: [id])
  signatureUrl String?
  signedAt     DateTime?
  ip           String?
  qrToken      String?     @unique

  @@unique([slotId, personId])
}

