// QualiOF — Prisma schema (MVP enrichi)
// Stack figée : PostgreSQL 16 + Prisma 5
// Convention : enums en MAJUSCULES, tables en PascalCase, champs en camelCase
// Référence : files/MVP-SPEC.md §4 + plan complémentaire (paliers + Airtable Refonte)
// Le modèle reprend la richesse de la base Airtable "BDD Start Academy Refonte" pour
// couvrir : pilotage CA, planning formateurs, pipeline leads, factures, workflow OPCO,
// référentiel Qualiopi par indicateur, RGPD (données sensibles séparées).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, uuid_ossp(map: "uuid-ossp"), pg_trgm, unaccent]
}

// =====================================================
// === Tenant & Auth (Lucia v3)
// =====================================================

model Tenant {
  id                     String   @id @default(uuid())
  name                   String
  siret                  String?
  numDA                  String?
  rcs                    String?
  // Phase 7 — paramètres OF éditables (SET-01/02/03). Toutes nullables :
  // null = fallback ENV (D-01 hybrid BDD/ENV). Première sauvegarde fait basculer
  // la source de vérité en BDD.
  legalForm              String? // forme juridique libre (SAS, EURL, ...) — voir enum LegalForm pour valeurs canoniques
  legalMentions          String?  @db.Text
  address                Json?
  invoicePrefix          String?  @default("FAC")
  iban                   String?
  bic                    String?
  emailFrom              String?
  logoPath               String? // ex "/of-assets/{tenantId}/logo.png"
  signaturePedagoPath    String?
  signatureDirigeantPath String?
  users                  User[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
  FORMATEUR
  COMMERCIAL
  COMPTABLE
  LECTEUR
}

model User {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String        @unique
  hashedPwd    String
  firstName    String
  lastName     String
  role         UserRole      @default(LECTEUR)
  authSessions AuthSession[]
  auditLogs    AuditLog[]
  leadsOwned   Lead[]
  tasksOwned   Task[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId])
}

model AuthSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

// =====================================================
// === CŒUR : résolution du cas EI / multi-casquettes
// =====================================================

model Person {
  id                     String                @id @default(uuid())
  tenantId               String
  civility               String?
  firstName              String
  lastName               String
  birthName              String?
  birthDate              DateTime?
  email                  String?
  phone                  String?
  personalAddress        Json?
  educationLevel         String?
  diplomas               String? // texte libre depuis Airtable.Diplômes / SmartOF
  professionalExperience String? // "1-3 ans", "4 ans", "10 ans", "Plus de 10 ans"
  professionalStatus     String? // "Agent commercial", "Conseiller commercial", etc.
  // Documents stockés en MinIO (uploadés au wizard de création apprenant)
  ribKey                 String? // RIB scanné (PDF/image) en MinIO
  bpfDefaultStatus       String?
  rgpdConsentAt          DateTime?
  requiresCleanup        Boolean               @default(false)
  cleanupNotes           String?
  archived               Boolean               @default(false)
  // Relations
  legalLinks             LegalLink[]
  participations         SessionParticipant[]
  trainerSessions        SessionTrainer[]
  attendances            Attendance[]
  trainerAvailabilities  TrainerAvailability[]
  sensitiveData          SensitiveData?
  contactRoles           Contact[] // un Person peut être référencé comme Contact d'organisations
  leadsAsPerson          Lead[]                @relation("LeadPerson")
  comments               InternalComment[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, email])
}

// 1:1 Person — données sensibles RGPD séparées (n° SS, pièce d'identité)
// Reprend le concept de la table Airtable "DONNÉES_SENSIBLES"
model SensitiveData {
  id               String    @id @default(uuid())
  personId         String    @unique
  person           Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  socialSecurityNb String?
  idDocumentUrl    String? // pièce d'identité scannée (MinIO)
  idDocumentType   String? // "CNI", "Passeport", "Titre séjour"
  verifiedAt       DateTime?
  verifiedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Organization {
  id                      String               @id @default(uuid())
  tenantId                String
  legalName               String
  legalForm               LegalForm
  siren                   String?
  siret                   String?
  naf                     String?
  vatNumber               String?
  address                 Json?
  phone                   String?
  email                   String?
  emailBilling            String? // adresse email facturation (souvent ≠ email général)
  phoneBilling            String?
  opcoCode                String? // ex : "AGEFICE", "ATLAS", "OPCO_EP", "CPF"
  opcoCatalogId           String?
  opcoCatalog             OpcoCatalog?         @relation(fields: [opcoCatalogId], references: [id])
  network                 String? // "Orpi", "Century 21", "Keller Williams", indé
  brandName               String? // enseigne / nom commercial
  representative          String?
  activityDescription     String?
  rcs                     String?
  type                    String? // "Client", "Partenaire", "Sous-traitant"
  archived                Boolean              @default(false)
  requiresCleanup         Boolean              @default(false)
  cleanupNotes            String?
  // Relations
  legalLinks              LegalLink[]
  sponsoredParticipations SessionParticipant[]
  billingProfiles         BillingProfile[]
  ageficeProfile          AgeficeProfile?
  contacts                Contact[]
  leadsAsOrg              Lead[]               @relation("LeadOrg")
  invoices                Invoice[]
  comments                InternalComment[]
  opcoSubmissions         OpcoSubmission[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([tenantId, legalName])
  @@index([tenantId, siren])
  @@index([tenantId, siret])
}

enum LegalForm {
  SAS
  SARL
  SASU
  EURL
  SA
  EI
  EIRL
  AUTO_ENTREPRENEUR
  ASSOCIATION
  PARTICULIER
  AUTRE
}

enum LinkRole {
  DIRIGEANT
  SALARIE
  EI_SELF
  AGENT_COMMERCIAL // pattern récurrent immobilier : indépendant rattaché à une enseigne (C21, Magrey, Orpi…)
  ALTERNANT
  STAGIAIRE
  CONTACT
  FINANCEUR_CONTACT
  FORMATEUR
}

model LegalLink {
  id             String       @id @default(uuid())
  personId       String
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           LinkRole
  function       String?
  startDate      DateTime?
  endDate        DateTime?
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([personId, organizationId, role])
  @@index([organizationId])
}

// Contact rattaché à une Organization (= "Contacts_rattachés" dans Airtable Structures)
// Différent d'un Person apprenant : ici c'est juste un interlocuteur dans l'entreprise.
// Souvent c'est un dirigeant RH, un responsable formation, un comptable.
model Contact {
  id               String       @id @default(uuid())
  tenantId         String
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personId         String? // si lié à un Person existant (ex : le contact est aussi apprenant)
  person           Person?      @relation(fields: [personId], references: [id])
  firstName        String
  lastName         String
  email            String?
  phone            String?
  function         String?
  isBillingContact Boolean      @default(false)
  isPrimary        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
}

model BillingProfile {
  id             String               @id @default(uuid())
  tenantId       String
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  invoiceName    String
  address        Json
  legalMentions  String?
  paymentMethod  String?
  participants   SessionParticipant[]
  invoices       Invoice[]
  createdAt      DateTime             @default(now())

  @@index([tenantId])
}

// =====================================================
// === Catalogue de formation
// =====================================================

enum Modality {
  PRESENTIEL
  DISTANCIEL
  MIXTE
  ELEARNING
}

model TrainingProduct {
  id                 String            @id @default(uuid())
  tenantId           String
  code               String
  title              String
  durationHours      Int
  modality           Modality
  prerequisites      String?
  targetAudience     String?
  objectives         Json // string[]
  programMd          String
  pedagogicalMethods String?
  evaluationMethods  String?
  accessibility      String?
  trainerProfile     String?
  pedagogicalSupport String?
  accessConditions   String?
  priceHT            Decimal           @default(0) @db.Decimal(10, 2)
  vatRate            Decimal           @default(0) @db.Decimal(5, 2)
  groupFlatPrice     Decimal?          @db.Decimal(10, 2) // Tarif_forfait_groupe
  theme              String? // "Acquisition", "Stratégie", "Management", "IA", etc.
  version            Int               @default(1)
  isActive           Boolean           @default(true)
  excludedFromBpf    Boolean           @default(false)
  bpfSpecialty       String?
  bpfCategory        String?
  bpfLevel           String?
  capacityMin        Int               @default(1)
  capacityMax        Int               @default(12)
  modules            TrainingModule[]
  trainingSessions   TrainingSession[]
  leads              Lead[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model TrainingModule {
  id                        String          @id @default(uuid())
  productId                 String
  product                   TrainingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  order                     Int
  title                     String
  contentMd                 String
  durationMin               Int
  presentielIndividualHours Int?
  presentielCollectifHours  Int?
  distancielSyncHours       Int?
  distancielAsyncHours      Int?

  @@index([productId, order])
}

// =====================================================
// === Sessions
// =====================================================

enum SessionStatus {
  DRAFT
  PLANNED
  OPEN // "Ouverte" dans Airtable, prête à recevoir des inscrits
  VALIDATED
  IN_PROGRESS
  COMPLETED // "Terminée"
  CANCELLED
}

model TrainingSession {
  id                    String               @id @default(uuid())
  tenantId              String
  productId             String
  product               TrainingProduct      @relation(fields: [productId], references: [id])
  code                  String               @unique
  name                  String? // Nom session = "Cycle complet de prospection (87h) - 21/10/2024 -"
  status                SessionStatus        @default(DRAFT)
  startDate             DateTime
  endDate               DateTime
  locationId            String?
  location              Location?            @relation(fields: [locationId], references: [id])
  modality              Modality
  capacityMin           Int                  @default(1)
  capacityMax           Int                  @default(12)
  language              String               @default("fr")
  internalNotes         String?
  // Tarification spécifique session (sinon hérite produit)
  pricePerLearner       Decimal?             @db.Decimal(10, 2)
  // Hébergement formateur (utilisé dans la check-list C4.i17 Qualiopi).
  // Saisi à la création de session ou lors du "Préparer la formation".
  needsTrainerLodging   Boolean              @default(false)
  trainerLodgingPlace   String?
  trainerLodgingDates   String? // Format libre "Du JJ/MM au JJ/MM" — saisi à la main
  // Accessibilité (PSH) pour la check-list — détail + adaptations à prévoir
  hasDisabledLearner    Boolean              @default(false)
  disabilityAdaptations String?
  // Suivi commercial
  preEnrollmentsFromMls Int                  @default(0) // NB_pre_inscription Airtable
  // Relations
  participants          SessionParticipant[]
  trainers              SessionTrainer[]
  slots                 SessionSlot[]
  documents             Document[]
  pedagogicalAssets     PedagogicalAsset[]
  leads                 Lead[]
  preEnrollments        PreEnrollment[]
  tasks                 Task[]
  comments              InternalComment[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, startDate])
}

model Location {
  id       String            @id @default(uuid())
  tenantId String
  name     String
  address  Json
  capacity Int?
  sessions TrainingSession[]
}

model SessionTrainer {
  id        String          @id @default(uuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  personId  String
  person    Person          @relation(fields: [personId], references: [id])
  role      String
  dailyRate Decimal?        @db.Decimal(10, 2)
  /// Formateur principal de la session — c'est lui qui apparaît comme
  /// signataire sur tous les documents Qualiopi (convention, grille, satisfaction…).
  /// 1 seul `isPrimary=true` par session ; les autres sont co-formateurs.
  isPrimary Boolean         @default(false)

  @@unique([sessionId, personId])
  @@index([sessionId, isPrimary])
}

model SessionSlot {
  id          String          @id @default(uuid())
  sessionId   String
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  date        DateTime
  startTime   String
  endTime     String
  halfDay     String // "morning" | "afternoon" | "full"
  attendances Attendance[]

  @@index([sessionId, date])
}

// Disponibilités déclarées par les formateurs (= "Disponibilites_formateurs" Airtable)
// Sert au planning et à la suggestion automatique de créneaux.
model TrainerAvailability {
  id        String   @id @default(uuid())
  tenantId  String
  trainerId String
  trainer   Person   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("available") // "available" | "busy" | "tentative"
  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId, trainerId, startsAt])
}

// =====================================================
// === Inscriptions (table riche, alignée sur Airtable Refonte)
// =====================================================

enum EnrollmentStatus {
  PRE_ENROLLED
  CONFIRMED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum FinancingMode {
  OPCO
  CPF
  ENTREPRISE // l'entreprise paye directement
  AUTOFINANCEMENT // l'apprenant paye lui-même
  POLE_EMPLOI
  AUTRE
}

enum FinancingStatus {
  NOT_STARTED
  REQUESTED // dossier déposé
  PRE_APPROVED // pré-accord OPCO reçu
  APPROVED // dossier validé
  REJECTED
  REIMBURSED // remboursement reçu
}

enum BillingType {
  STRUCTURE // facturation à l'entreprise
  PERSONNE // facturation au particulier
  OPCO_DIRECT // tiers payeur OPCO
  CPF // financement CPF
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WRITE_OFF
}

/// US-008 : distingue les vraies inscriptions formation des dossiers de
/// "pré-inscription budget" — réservation d'un budget OPCO sans formation
/// définitivement planifiée (ex: dépôt AGEFICE en décembre pour budget 2026).
enum DossierType {
  FORMATION
  PREINSCRIPTION_BUDGET
}

model SessionParticipant {
  id               String          @id @default(uuid())
  sessionId        String
  session          TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  personId         String
  person           Person          @relation(fields: [personId], references: [id])
  // 👇 LE point de pivot. C'est CETTE org qui paye et qui apparaît sur la convention.
  sponsorOrgId     String
  sponsorOrg       Organization    @relation(fields: [sponsorOrgId], references: [id])
  billingProfileId String?
  billingProfile   BillingProfile? @relation(fields: [billingProfileId], references: [id])

  // Tarification
  priceHT         Decimal @default(0) @db.Decimal(10, 2)
  amountCollected Decimal @default(0) @db.Decimal(10, 2)
  amountRemaining Decimal @default(0) @db.Decimal(10, 2)

  // Statuts
  enrollmentStatus EnrollmentStatus @default(PRE_ENROLLED)
  bpfStatus        String?
  participantType  String? // "Salarié", "Dirigeant", "EI"
  payerOrgId       String? // si différent du sponsorOrg (rare mais possible)
  payerContactId   String? // contact destinataire de la facturation

  // Workflow financement
  financingMode         FinancingMode?
  financingStatus       FinancingStatus @default(NOT_STARTED)
  financingRefNumber    String? // référence dossier OPCO
  financingRequestDate  DateTime?
  financingApprovalDate DateTime?

  // Workflow facturation
  billingType   BillingType?
  paymentStatus PaymentStatus @default(PENDING)

  // Checklist Qualiopi (booleans calqués sur Airtable Inscriptions)
  conventionSigned         Boolean   @default(false)
  programmeDelivered       Boolean   @default(false)
  certificateDelivered     Boolean   @default(false)
  pedagogicalSupportsGiven Boolean   @default(false)
  attendanceSheetCollected Boolean   @default(false)
  assiduitySheetCollected  Boolean   @default(false)
  evaluationCollected      Boolean   @default(false)
  satisfactionCollected    Boolean   @default(false)
  closingDocsSent          Boolean   @default(false)
  invoiceSent              Boolean   @default(false)
  paymentReceived          Boolean   @default(false)
  // Dates de transition false→true (calcul DSO et delais OPCO)
  invoiceSentAt            DateTime?
  paymentReceivedAt        DateTime?
  opcoApprovedAt           DateTime?
  opcoReimbursedAt         DateTime?
  opcoPreApproved          Boolean   @default(false)
  opcoApproved             Boolean   @default(false)
  opcoReimbursed           Boolean   @default(false)

  // US-008 : type de dossier — par défaut une vraie inscription formation,
  // peut être basculé en "réservation budget" pour les dossiers déposés
  // sans formation définitivement calée (ex: AGEFICE budget annuel).
  dossierType DossierType @default(FORMATION)

  // Erreur de cohérence détectée (= "Erreur_payeur" dans Airtable)
  payerErrorMessage String?
  internalNotes     String?

  // Relations
  invoices        Invoice[]
  comments        InternalComment[]
  tasks           Task[]
  agreementDocs   Document[] // les documents Qualiopi rattachés à cette inscription
  opcoSubmissions OpcoSubmission[] // dossiers OPCO envoyés au financeur

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, personId])
  @@index([sponsorOrgId])
  @@index([financingStatus])
  @@index([paymentStatus])
  @@index([dossierType])
}

model Attendance {
  id           String      @id @default(uuid())
  slotId       String
  slot         SessionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  personId     String
  person       Person      @relation(fields: [personId], references: [id])
  signatureUrl String?
  signedAt     DateTime?
  ip           String?
  qrToken      String?     @unique

  @@unique([slotId, personId])
}

// =====================================================
// === Pipeline commercial : Leads
// =====================================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON // converti en SessionParticipant
  LOST
  ON_HOLD
  TO_FOLLOWUP // "A relancer"
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Lead {
  id                  String            @id @default(uuid())
  tenantId            String
  source              String? // "Formulaire", "Linkedin", "Salon", "Recommandation", etc.
  status              LeadStatus        @default(NEW)
  priority            LeadPriority      @default(MEDIUM)
  // Identité du prospect (peut être Person existant OU saisie libre)
  personId            String?
  person              Person?           @relation("LeadPerson", fields: [personId], references: [id])
  organizationId      String?
  organization        Organization?     @relation("LeadOrg", fields: [organizationId], references: [id])
  firstName           String?
  lastName            String?
  email               String?
  phone               String?
  // Intérêt
  interestedProductId String?
  interestedProduct   TrainingProduct?  @relation(fields: [interestedProductId], references: [id])
  desiredSessionId    String?
  desiredSession      TrainingSession?  @relation(fields: [desiredSessionId], references: [id])
  // Suivi commercial
  ownerUserId         String?
  owner               User?             @relation(fields: [ownerUserId], references: [id])
  lastActionAt        DateTime?
  lastAction          String?
  nextActionAt        DateTime?
  nextAction          String?
  reminderTemplate    String? // "Formule_relance" Airtable
  validatedAt         DateTime?
  notes               String?
  // Relations
  actions             LeadAction[]
  tasks               Task[]
  comments            InternalComment[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, ownerUserId])
}

model LeadAction {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       String // "call" | "email" | "meeting" | "note"
  subject    String
  body       String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([leadId, occurredAt])
}

// =====================================================
// === Facturation
// =====================================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
  CREDIT_NOTE
}

model Invoice {
  id               String              @id @default(uuid())
  tenantId         String
  number           String              @unique // numérotation continue (FAC-NNNNNN)
  status           InvoiceStatus       @default(DRAFT)
  // Liens métier
  participantId    String?
  participant      SessionParticipant? @relation(fields: [participantId], references: [id])
  participantIds   Json? // si facture multi-participants groupée par sponsor (salariés d'une SARL)
  sessionId        String? // session dont sont issus les participants (pour facture groupée)
  payerOrgId       String?
  payerOrg         Organization?       @relation(fields: [payerOrgId], references: [id])
  payerContactId   String? // optionnel : un Contact spécifique
  billingProfileId String?
  billingProfile   BillingProfile?     @relation(fields: [billingProfileId], references: [id])
  // Montants
  amountHT         Decimal             @default(0) @db.Decimal(10, 2)
  vatRate          Decimal             @default(0) @db.Decimal(5, 2)
  amountTTC        Decimal             @default(0) @db.Decimal(10, 2)
  amountPaid       Decimal             @default(0) @db.Decimal(10, 2)
  // Dates
  issueDate        DateTime?
  dueDate          DateTime?
  paidAt           DateTime?
  // PDF
  pdfUrl           String?
  hashSha256       String?
  // Notes
  notes            String?
  // Paiements
  payments         InvoicePayment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, issueDate])
}

model InvoicePayment {
  id         String   @id @default(uuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method     String // "virement" | "cheque" | "cb" | "prelevement" | "especes"
  amount     Decimal  @db.Decimal(10, 2)
  receivedAt DateTime
  reference  String?
  notes      String?
  createdAt  DateTime @default(now())
}

// =====================================================
// === Documents (Qualiopi)
// =====================================================

enum DocType {
  CONVENTION
  PROGRAMME
  DEROULE_PEDAGOGIQUE // 1 par produit (asset partagé) — ajouté 05/05/2026
  CHECKLIST_FORMATION // 1 par session — C4.i17 Qualiopi
  GRILLE_OBS_SESSION // 1 par session (consolidée formateur) — C3.i11 Qualiopi
  CONVOCATION
  EMARGEMENT
  ASSIDUITE
  ATTESTATION_FIN
  CERTIFICAT_REALISATION
  AGEFICE
  EVALUATION_ACQUIS
  SATISFACTION
  /// Bilan satisfaction agrégé pour TOUTE la session — moyenne des satisfactions
  /// chaud individuelles + points forts/faibles + taux recommandation NPS.
  /// 1 par session, indicateur Qualiopi 30. Ajouté 12/05/2026.
  SATISFACTION_SESSION
  SUPPORT_PEDAGOGIQUE
  PRE_ACCORD_OPCO
  VALIDATION_OPCO
  FACTURE
  CUSTOM
}

// Référentiel des types de documents Qualiopi (issu de la table Airtable Documents_Qualiopi)
// Ne stocke pas les fichiers — c'est une métadonnée éditoriale qui mappe DocType à un indicateur Qualiopi.
model QualiopiDocCatalog {
  id                String   @id @default(uuid())
  type              DocType  @unique
  name              String // "Convention de formation"
  phase             String // "Pré-formation" | "Formation" | "Post-formation" | "Administratif"
  qualiopiIndicator String? // "Indicateur 7", "Indicateur 30", "Légal Art. L6353-1"
  isMandatory       Boolean  @default(true)
  description       String?
  recommendedDelay  String?
  responsible       String? // "OF", "Apprenant", "OPCO", "Formateur"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

