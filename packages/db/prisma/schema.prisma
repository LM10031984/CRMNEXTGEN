  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
}

// =====================================================
// === [Plan additions] — extensions IA / AGEFICE / sync
// =====================================================

model AgeficeProfile {
  id                         String               @id @default(uuid())
  organizationId             String               @unique
  organization               Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // PA AGEFICE rattaché — privilégier la FK vers le référentiel AgeficePointAccueil ;
  // les champs paName/paNumber/paContact/paAddress sont conservés pour compatibilité
  // avec les imports SmartOF (saisie texte libre) et pour override manuel rare.
  pointAccueilId             String?
  pointAccueil               AgeficePointAccueil? @relation(fields: [pointAccueilId], references: [id])
  pointAccueilLockedManually Boolean              @default(false) // true = ne pas réécrire au prochain import
  paName                     String? // "AGEFICE 06"
  paNumber                   String?
  paContact                  String?
  paAddress                  Json?
  paFields                   Json // 54 champs PDF AGEFICE pré-remplis
  pdfTemplateVersion         String               @default("2023-2024")
  // Dernière CFP déclarée (cf attestation URSSAF) — alimente le badge
  // "Budget AGEFICE disponible" sur la fiche apprenant.
  // Règle N-1 → N : CFP exercice 2024 donne des droits utilisables en 2025.
  lastCfpAmount              Float?
  lastCfpYear                Int? // exercice de la CFP (ex: 2024)
  lastCfpEligibleBudget      Int? // 3000 | 600 | 0 — calculé selon montant
  cfpAttestationKey          String? // Attestation CFP scannée en MinIO
  updatedAt                  DateTime             @updatedAt
  createdAt                  DateTime             @default(now())
}

// Pré-inscription publique : un contact reçoit un lien unique, dépose ses pièces,
// l'IA extrait les données, l'admin valide et convertit en Person+Org+LegalLink.
enum PreEnrollmentStatus {
  PENDING_FORM // lien généré, attente du contact
  SUBMITTED // formulaire soumis, fichiers reçus
  EXTRACTING // pipeline IA en cours
  EXTRACTED // données extraites, prêt à valider
  VALIDATED // admin a validé
  CONVERTED // converti en Person + Org + LegalLink + AgeficeProfile
  EXPIRED
  REJECTED
}

model PreEnrollment {
  id                     String              @id @default(uuid())
  tenantId               String
  // Lien public unique
  token                  String              @unique
  expiresAt              DateTime
  // Émission
  sentByUserId           String?
  sentTo                 String? // email contact (info audit)
  sentAt                 DateTime?
  // Identité saisie par le contact
  firstName              String?
  lastName               String?
  email                  String?
  phone                  String?
  birthDate              DateTime?
  birthPlace             String?
  professionalStatus     String? // "Agent commercial" / "Salarié" / "Dirigeant"
  educationLevel         String?
  diploma                String?
  professionalExperience String?
  // Champs du formulaire public par session (spec 2026-08-28). Le n° de
  // sécurité sociale n'est VOLONTAIREMENT pas ici : il va directement dans
  // SensitiveData à la validation (minimisation RGPD).
  birthName              String?
  address                String?
  city                   String?
  postalCode             String?
  companyName            String?
  companySiret           String?
  managerSince           String?
  // Fichiers MinIO (clés relatives au bucket)
  cniKey                 String?
  // Verso de la pièce d'identité : une CNI ou un titre de séjour a deux faces,
  // et une photo au smartphone n'en capture qu'une. Optionnel (un passeport
  // n'a qu'une page). Le verso porte la MRZ, très fiable pour l'OCR.
  cniVersoKey            String?
  ribKey                 String?
  cfpKey                 String? // Attestation CFP AGEFICE
  rgpdAcceptedAt         DateTime?
  submittedAt            DateTime?
  // Relances email auto pour les pré-inscriptions PENDING_FORM trop anciennes
  lastReminderSentAt     DateTime?
  reminderCount          Int                 @default(0)
  // Pipeline IA
  status                 PreEnrollmentStatus @default(PENDING_FORM)
  extractedData          Json? // données structurées extraites par l'IA
  aiExtractedAt          DateTime?
  aiModel                String?
  aiPromptVersion        String?
  aiErrorMsg             String?
  // Validation admin
  validatedByUserId      String?
  validatedAt            DateTime?
  rejectionReason        String?
  // Conversion en apprenant
  convertedToPersonId    String?
  convertedToOrgId       String?
  convertedAt            DateTime?
  // Pré-inscription ciblée à une session (optionnel)
  intendedSessionId      String?
  intendedSession        TrainingSession?    @relation(fields: [intendedSessionId], references: [id])
  // Audit
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([tenantId, status])
  @@index([token])
  @@index([intendedSessionId, status])
}

// Référentiel officiel des Points d'Accueil AGEFICE en France (438 PA, source : agefice.fr)
model AgeficePointAccueil {
  id             String           @id @default(uuid())
  name           String // "CCI Nice Côte d'Azur"
  address1       String?
  address2       String?
  postalCode     String // "06000" (string padding 5)
  city           String // "NICE"
  department     String // "06" — calculé depuis postalCode (2 chars, 3 pour DOM-TOM 97X/98X)
  departmentName String?
  phone          String? // "04 93 13 75 00"
  email          String?
  website        String?
  contactName    String? // ex: "Virginie BEHIN" — interlocuteur principal du PA pour les dossiers AGEFICE
  numberPta      String? // n° de Point d'Accueil attribué par AGEFICE (ex: "370" pour Nice)
  source         String           @default("agefice.fr-2025") // versioning du référentiel
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  profiles       AgeficeProfile[]

  @@unique([postalCode, name]) // clé naturelle pour upsert idempotent
  @@index([department])
  @@index([city])
}

enum PedagogicalKind {
  ANALYSE_BESOIN
  QCM
  GRILLE_OBS
  COMPETENCES
  DEROULE
  POSITIONNEMENT
  SATISFACTION_CHAUD
  SATISFACTION_FROID
  EMARGEMENT
}

model PedagogicalAsset {
  id            String          @id @default(uuid())
  tenantId      String
  kind          PedagogicalKind
  sessionId     String
  session       TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String?
  rawJson       Json
  pdfUrl        String?
  hashSha256    String?
  generatedAt   DateTime        @default(now())

  @@unique([sessionId, participantId, kind])
  @@index([tenantId, kind])
}

model AIGenerationJob {
  id            String   @id @default(uuid())
  tenantId      String
  provider      String
  model         String
  // Version du prompt utilisé pour cette génération — cf qualiopi-prompts.PROMPT_VERSION.
  // Indispensable pour répondre à un audit Qualiopi qui demanderait
  // "quel prompt a généré le QCM de Mme X le 12/02/2026".
  promptVersion String?
  inputHash     String
  status        String
  retries       Int      @default(0)
  latencyMs     Int?
  errorMsg      String?
  refTable      String
  refId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
  @@index([refTable, refId])
}

model ExternalIdentity {
  id         String   @id @default(uuid())
  tenantId   String
  entityType String
  entityId   String
  source     String // "smartof" | "qualiopi-gen" | "airtable"
  externalId String
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
  @@index([tenantId, entityType, entityId])
}

// =====================================================
// === Pack fin de formation (palier 4) — orchestration BullMQ
// =====================================================

// 5 types de docs générés par le bouton "📦 Pack fin de formation"
// ATTESTATION + CERTIFICAT → écrits dans Document (DocType.ATTESTATION_FIN/CERTIFICAT_REALISATION)
// QCM + GRILLE_OBS + ANALYSE_BESOIN → écrits dans PedagogicalAsset
enum ClosureDocKind {
  ATTESTATION
  CERTIFICAT
  QCM
  GRILLE_OBS
  ANALYSE_BESOIN
  POSITIONNEMENT
  SATISFACTION_CHAUD
  SATISFACTION_FROID
  DEROULE_PEDA
  EMARGEMENT
}

enum ClosureBatchStatus {
  PENDING
  RUNNING
  COMPLETED // tous les jobs ok
  PARTIAL // au moins 1 job en erreur, reste ok
  FAILED // tous les jobs en erreur
}

enum ClosureJobStatus {
  QUEUED
  PROCESSING
  DONE
  ERROR
}

model ClosureBatch {
  id              String             @id @default(uuid())
  tenantId        String
  sessionId       String
  status          ClosureBatchStatus @default(PENDING)
  totalDocs       Int                @default(0)
  doneDocs        Int                @default(0)
  errorDocs       Int                @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdByUserId String?
  jobs            ClosureJob[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([tenantId, sessionId])
  @@index([status])
}

model ClosureJob {
  id                 String           @id @default(uuid())
  batchId            String
  batch              ClosureBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  participantId      String
  kind               ClosureDocKind
  status             ClosureJobStatus @default(QUEUED)
  attempts           Int              @default(0)
  errorMessage       String?
  // Réfs vers le doc produit
  documentId         String? // si kind ∈ {ATTESTATION, CERTIFICAT}
  pedagogicalAssetId String? // si kind ∈ {QCM, GRILLE_OBS, ANALYSE_BESOIN}
  // True si l'IA Ollama a échoué et qu'on a fallback sur stub-content.ts —
  // le PDF est produit (status DONE) mais avec un contenu générique non
  // personnalisé. À régénérer manuellement avant un audit Qualiopi.
  usedStub           Boolean          @default(false)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([batchId, participantId, kind])
  @@index([batchId, status])
}

// =====================================================
// === Veille Qualiopi (Phase 13 — VEILLE-01)
// =====================================================

/// Phase 13 — Veille Qualiopi (VEILLE-01).
/// Couvre le critère 6 Qualiopi : indicateurs 23/24/25/26.
/// Source : import xlsx one-shot + saisie manuelle + suggestions auto via worker RSS+Ollama (Plan 05).
model RegulatoryWatch {
  id               String                @id @default(uuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  theme            RegulatoryWatchTheme
  title            String
  url              String?
  source           String?
  modeSuivi        String?
  typeSource       String?
  responsable      String?
  frequency        String?
  exploitation     String?               @db.Text
  dateAdded        DateTime              @default(now())
  dateLastReviewed DateTime?
  status           RegulatoryWatchStatus @default(ACTIVE)
  suggestedBy      RegulatoryWatchSource @default(USER)
  rssSourceUrl     String?
  rawSnippet       String?               @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([tenantId, theme, status])
  @@index([tenantId, status, suggestedBy])
  @@index([tenantId, dateLastReviewed])
}

enum RegulatoryWatchTheme {
  INDIC_23
  INDIC_24
  INDIC_25
  INDIC_26
}

enum RegulatoryWatchStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RegulatoryWatchSource {
  USER
  IMPORT
  AUTO
}

// Pilotage Direction (quick 260620-d42) — objectif CA annuel par tenant/année.
// Pas de relation inverse sur Tenant : tenantId reste une colonne FK logique non contrainte
// (évite de toucher le model Tenant). Objectif stocké en euros HT entiers (pas de centimes).
model RevenueTarget {
  id        String   @id @default(uuid())
  tenantId  String
  year      Int
  amountHT  Int // objectif annuel en euros HT (entier — pas de centimes pour un objectif)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tenantId, year])
  @@index([tenantId])
}

// =====================================================
// === Synchro Google Calendar (Phase 14)
// =====================================================

/// Phase 14 — trace de synchro Google Calendar par session.
/// Second filet d'idempotence (en complément de la clé déterministe écrite dans
/// extendedProperties.private côté Google) ET preuve d'audit Qualiopi du backfill :
/// quelle session a quels événements créés, quand, en quel mode, avec quel
/// sendUpdates appliqué. L'orchestrateur (Plan 14-04) upsert une ligne par
/// événement (clé composite sessionId + eventKey), ce qui permet à un re-run de
/// décider skip/update au lieu de dupliquer.
model SessionCalendarSync {
  id            String          @id @default(uuid())
  tenantId      String
  sessionId     String
  session       TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventKey      String // buildEventKey(...) déterministe — Plan 14-01
  googleEventId String // id retourné par events.insert
  eventType     String // 'formation' | 'rappel' | 'froid'
  dayIndex      Int? // index du rappel quotidien / relance froid
  syncMode      String // 'backfill' | 'auto'
  sentUpdates   String // 'all' | 'none' — sendUpdates appliqué à l'insert
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([sessionId, eventKey])
  @@index([tenantId, sessionId])
}

// =====================================================
// === Garde-fou applicatif envois emails (Phase 22)
// =====================================================

/// Phase 22 Plan 22-11 D-06 : garde-fou applicatif envois — fail-closed par défaut.
/// Couche MÉTIER de la décision d'envoi (la couche env MAIL_DRY_RUN reste la
/// plomberie, prioritaire) : interrupteur général + toggles par catégorie +
/// sessions autorisées en mode test, pilotés depuis Paramètres organisme.
/// Tout à false au déploiement : sans action explicite de l'ADMIN, AUCUN email
/// applicatif ne part — même après MAIL_DRY_RUN=false.
/// Pattern FK-less (précédent RevenueTarget) : évite de toucher le model Tenant.
model TenantEmailSettings {
  id                             String   @id @default(uuid())
  tenantId                       String   @unique
  emailsEnabled                  Boolean  @default(false)
  invoiceRemindersEnabled        Boolean  @default(false)
  preinscriptionRemindersEnabled Boolean  @default(false)
  opcoRemindersEnabled           Boolean  @default(false)
  opcoSubmissionsEnabled         Boolean  @default(false)
  internalNotificationsEnabled   Boolean  @default(false)
  userInvitationsEnabled         Boolean  @default(false)
  diagnosticProgramsEnabled      Boolean  @default(false)
  testSessionIds                 String[] @default([])
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @default(now()) @updatedAt
}

/// Quick 260901-qr7 — une soumission du diagnostic express du stand.
///
/// Pourquoi une table et pas seulement le `notes` du Lead : le résumé texte est
/// lisible par un humain mais illisible par un programme. La personnalisation
/// du programme a besoin des réponses STRUCTURÉES, et l'envoi doit pouvoir être
/// rejoué sans dépendre d'un parsing de texte libre.
model DiagnosticSubmission {
  id       String  @id @default(uuid())
  tenantId String
  /// Le lead créé au même moment. Cascade : si le lead part, la soumission part
  /// avec lui (RGPD — pas de PII orpheline).
  leadId   String?
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Réponses brutes { questionId: choixValue }, validées contre QUESTIONS.
  reponses   Json
  /// Problématique retenue et suivante (clés de ProblematiqueKey).
  dominante  String
  secondaire String?
  /// Score par problématique, utile au commercial qui rappelle.
  scores     Json

  /// État de l'envoi du programme personnalisé (worker cron).
  programmeStatus  DiagnosticProgrammeStatus @default(PENDING)
  programmeSentAt  DateTime?
  /// Nombre de tentatives du worker. Au-delà du plafond → FAILED, plus de retry.
  attempts         Int                       @default(0)
  lastError        String?
  /// Trace de ce qui a été effectivement envoyé — utile si le prospect rappelle
  /// en citant son programme.
  personnalisation Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programmeStatus, createdAt])
  @@index([tenantId])
}

enum DiagnosticProgrammeStatus {
  PENDING
  SENT
  FAILED
  /// Catégorie d'email décochée dans Paramètres : rien n'est parti, et ce n'est
  /// pas une erreur. Distinguer les deux évite de chercher une panne.
  SKIPPED
}

// ═══════════════════════════════════════════════════════════════════════
// Facturation électronique — spec du 02/09/2026, lot 1 (socle de données)
//
// Le profil EN 16931 exige des LIGNES (quantité, prix unitaire, catégorie
// de TVA par ligne) : `Invoice` portait ses montants à plat, ce qui rendait
// tout Factur-X impossible. Et il exige un vendeur et un acheteur FIGÉS —
// un PDF rendu depuis des données vivantes est l'écart E-1 appliqué à une
// pièce comptable, cette fois transmise à une plateforme d'État.
// ═══════════════════════════════════════════════════════════════════════

model InvoiceLine {
  id                     String  @id @default(uuid())
  invoiceId              String
  invoice                Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position               Int
  label                  String
  quantity               Decimal @db.Decimal(10, 2)
  /// UN/ECE rec. 20 : C62 unité, HUR heure, DAY jour.
  unit                   String  @default("C62")
  unitPriceHT            Decimal @db.Decimal(10, 2)
  vatRate                Decimal @db.Decimal(5, 2)
  /// EN 16931 : S standard, E exonéré, K intracom, AE autoliquidation…
  /// Start Academy est en E (formation professionnelle continue).
  vatCategory            String  @default("E")
  /// Code VATEX — décision D-2 NON tranchée : laissé null tant que le code
  /// exact de l'art. 261-4-4°a n'est pas confirmé. Ne pas inventer.
  vatExemptionReasonCode String?
  vatExemptionReasonText String?
  /// Traçabilité sur une facture groupée : quelle ligne pour quel stagiaire.
  participantId          String?
  totalHT                Decimal @db.Decimal(10, 2)

  @@index([invoiceId, position])
}

/// Snapshot des parties, figé à l'émission. Pas de FK vivante : une facture
/// émise ne doit plus jamais changer parce qu'une organisation a été éditée.
model InvoiceParty {
  id                      String           @id @default(uuid())
  invoiceId               String
  invoice                 Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  role                    InvoicePartyRole
  legalName               String
  siren                   String?
  siret                   String?
  vatNumber               String?
  addressLine1            String?
  addressLine2            String?
  postalCode              String?
  city                    String?
  countryCode             String           @default("FR")
  email                   String?
  /// Identifiant d'annuaire : "0225" = SIREN France, "0002" = SIRET.
  electronicAddressScheme String?
  electronicAddress       String?

  @@unique([invoiceId, role])
}

enum InvoicePartyRole {
  SELLER
  BUYER
  DELIVERY
}

/// Une transmission = une tentative vers une plateforme. Plusieurs par
/// facture : un rejet puis un renvoi sont deux tentatives, pas un écrasement.
model EInvoiceTransmission {
  id            String          @id @default(uuid())
  tenantId      String
  invoiceId     String
  invoice       Invoice         @relation(fields: [invoiceId], references: [id])
  provider      String
  format        EInvoiceFormat
  profile       String          @default("EN16931")
  /// Clé de stockage de l'XML EXACT envoyé — pas une régénération.
  xmlStorageKey String
  pdfStorageKey String?
  xmlSha256     String
  /// Id côté plateforme. Texte : les ids Super PDP sont des int64.
  externalId    String?
  status        EInvoiceStatus  @default(PENDING)
  statusDetail  String?
  submittedAt   DateTime?
  lastPolledAt  DateTime?
  events        EInvoiceEvent[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  /// Idempotence : le même XML renvoyé ne crée pas un doublon côté plateforme.
  @@unique([invoiceId, xmlSha256])
  @@index([tenantId, status])
  @@index([invoiceId])
}

enum EInvoiceFormat {
  FACTURX
  UBL
  CII
}

/// Cycle de vie normalisé (sous-ensemble DGFiP). Ne REMPLACE PAS
/// `InvoiceStatus` : l'un est le cycle interne, l'autre celui de la
/// plateforme. Les deux coexistent et ne disent pas la même chose.
enum EInvoiceStatus {
  PENDING
  SUBMITTED
  DEPOSITED
  REJECTED_PLATFORM
  RECEIVED
  REFUSED_BUYER
  APPROVED
  PAID_REPORTED
  ERROR
}

model EInvoiceEvent {
  id             String               @id @default(uuid())
  transmissionId String
  transmission   EInvoiceTransmission @relation(fields: [transmissionId], references: [id], onDelete: Cascade)
  status         EInvoiceStatus
  /// Réponse brute de la plateforme, conservée telle quelle : le jour où un
  /// statut est contesté, c'est elle qui fait foi, pas notre interprétation.
  payload        Json?
  /// Code natif de la plateforme (`api:validated`, `fr:205`, `ppf:refused`…)
  /// gardé À CÔTÉ du statut normalisé : le mapping vers `EInvoiceStatus` est
  /// une interprétation, et le code d'origine doit rester relisible.
  providerCode   String?
  occurredAt     DateTime
  createdAt      DateTime             @default(now())

  @@index([transmissionId, occurredAt])
}
