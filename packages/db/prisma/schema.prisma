// =====================================================
// === Facturation
// =====================================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
  CREDIT_NOTE
}

model Invoice {
  id                  String                 @id @default(uuid())
  tenantId            String
  number              String                 @unique // numérotation continue (FAC-NNNNNN)
  status              InvoiceStatus          @default(DRAFT)
  // Phase 11 — Avoirs (D-01). Self-FK : un avoir pointe vers la facture annulée.
  originalInvoiceId   String?
  originalInvoice     Invoice?               @relation("InvoiceToCreditNote", fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  creditNotes         Invoice[]              @relation("InvoiceToCreditNote")
  // Phase 11 — Tracking relances (D-13b). Idempotence + auto-stop.
  lastReminderAt      DateTime?
  reminderCount       Int                    @default(0)
  // Liens métier
  participantId       String?
  participant         SessionParticipant?    @relation(fields: [participantId], references: [id])
  participantIds      Json? // si facture multi-participants groupée par sponsor (salariés d'une SARL)
  sessionId           String? // session dont sont issus les participants (pour facture groupée)
  payerOrgId          String?
  payerOrg            Organization?          @relation(fields: [payerOrgId], references: [id])
  payerContactId      String? // optionnel : un Contact spécifique
  billingProfileId    String?
  billingProfile      BillingProfile?        @relation(fields: [billingProfileId], references: [id])
  // Montants
  amountHT            Decimal                @default(0) @db.Decimal(10, 2)
  vatRate             Decimal                @default(0) @db.Decimal(5, 2)
  amountTTC           Decimal                @default(0) @db.Decimal(10, 2)
  amountPaid          Decimal                @default(0) @db.Decimal(10, 2)
  // Dates
  issueDate           DateTime?
  dueDate             DateTime?
  paidAt              DateTime?
  // PDF
  pdfUrl              String?
  hashSha256          String?
  // Notes
  notes               String?
  // ── Facturation électronique (spec 02/09/2026, lot 1) ──────────────────
  /// Adresse de livraison quand elle diffère de l'adresse de facturation —
  /// mention devenue obligatoire par la réforme. Pour un OF : le lieu de
  /// formation, qui n'est presque jamais le siège du payeur.
  deliveryAddressJson Json?
  /// Nature de l'opération : SERVICES | GOODS | MIXED (mention obligatoire).
  supplyNature        String                 @default("SERVICES")
  /// Option TVA sur les débits (mention obligatoire). Faux pour une
  /// prestation exonérée, mais le champ doit exister et être figé.
  vatOnDebits         Boolean                @default(false)
  /// Lot 0 · E-1 appliqué à la facture : empreinte des données rendues,
  /// figée à l'émission. Cf. `apps/web/src/lib/docs/source-fingerprint.ts`
  /// pour la primitive — même normalisation, mêmes trois verdicts.
  sourceFingerprint   String?
  // Paiements
  payments            InvoicePayment[]
  // Facturation électronique
  lines               InvoiceLine[]
  parties             InvoiceParty[]
  transmissions       EInvoiceTransmission[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, issueDate])
  // Phase 11 — index pour worker daily relances (scan status + lastReminderAt par tenant).
  @@index([tenantId, status, lastReminderAt])
  // Phase 11 — lookup inverse "quels avoirs sont liés à cette facture ?"
  @@index([originalInvoiceId])
}

model InvoicePayment {
  id         String   @id @default(uuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method     String // "virement" | "cheque" | "cb" | "prelevement" | "especes"
  amount     Decimal  @db.Decimal(10, 2)
  receivedAt DateTime
  reference  String?
  notes      String?
  createdAt  DateTime @default(now())
}

/// Devis commercial — workflow hybride : champs destinataire 100% libres
/// (recipientName, recipientEmail, recipientAddress) MAIS possibilité
/// de pré-remplir depuis un Person/Organization existant (productId, personId,
/// organizationId stockés en mémoire pour traçabilité, pas pour binding fort).
///
/// `headerCustomMd` permet d'override l'entête tenant par défaut (logo + raison
/// sociale + SIRET tenant) avec un markdown libre — utile pour les devis en
/// marque blanche ou avec entête spécifique commanditaire.
///
/// Numérotation DEV-NNNN (cohérente avec PROD-NNNN, INV-NNNN, SES-NNNN).
/// Statuts : DRAFT → SENT → ACCEPTED | REJECTED | EXPIRED.
model Quote {
  id               String      @id @default(uuid())
  tenantId         String
  number           String      @unique // DEV-NNNN
  status           QuoteStatus @default(DRAFT)
  // Destinataire — champs libres (peuvent être pré-remplis depuis un Person/Org existant)
  recipientName    String // "Dupont SARL" ou "Marie Dupont" si particulier
  recipientContact String? // "À l'attention de Marie Dupont" — optionnel si recipientName est déjà un nom propre
  recipientAddress String? // adresse multilignes
  recipientEmail   String?
  recipientSiret   String?
  // Traçabilité du pré-remplissage (informatif, pas FK strict pour rester souple)
  sourceProductId  String?
  sourcePersonId   String?
  sourceOrgId      String?
  // Personnalisation entête
  headerCustomMd   String? // si null → header tenant par défaut (logo + raison sociale + SIRET)
  // Métadonnées commerciales
  title            String      @default("Devis de formation") // titre affiché sur le PDF
  notes            String? // notes internes ou bas de devis (conditions, mentions)
  validUntil       DateTime? // date de validité du devis
  // Montants — calculés depuis les QuoteLine, persistés pour rapidité liste
  amountHT         Decimal     @default(0) @db.Decimal(10, 2)
  amountVAT        Decimal     @default(0) @db.Decimal(10, 2)
  amountTTC        Decimal     @default(0) @db.Decimal(10, 2)
  // Dates statut
  issuedAt         DateTime? // passage DRAFT → SENT
  acceptedAt       DateTime? // passage SENT → ACCEPTED
  rejectedAt       DateTime? // passage SENT → REJECTED
  // PDF
  pdfUrl           String? // MinIO key, null tant que non généré
  // Relations
  lines            QuoteLine[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Ligne d'un devis. Description libre, quantité décimale (heures, jours,
/// apprenants), prix unitaire HT, taux TVA. `lineTotalHT` = quantité × prix unit
/// (recalculé côté server à chaque update, jamais saisi à la main).
model QuoteLine {
  id          String  @id @default(uuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  order       Int // position dans le devis (0-indexé)
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPriceHT Decimal @default(0) @db.Decimal(10, 2)
  vatRate     Decimal @default(0) @db.Decimal(5, 2) // 20.00 = 20% (0 = exonéré formation FR)
  lineTotalHT Decimal @default(0) @db.Decimal(10, 2)

  @@index([quoteId, order])
}

// =====================================================
// === Documents (Qualiopi)
// =====================================================

enum DocType {
  CONVENTION
  PROGRAMME
  DEROULE_PEDAGOGIQUE // 1 par produit (asset partagé) — ajouté 05/05/2026
  CHECKLIST_FORMATION // 1 par session — C4.i17 Qualiopi
  GRILLE_OBS_SESSION // 1 par session (consolidée formateur) — C3.i11 Qualiopi
  CONVOCATION
  EMARGEMENT
  ASSIDUITE
  ATTESTATION_FIN
  CERTIFICAT_REALISATION
  AGEFICE
  EVALUATION_ACQUIS
  SATISFACTION
  /// Bilan satisfaction agrégé pour TOUTE la session — moyenne des satisfactions
  /// chaud individuelles + points forts/faibles + taux recommandation NPS.
  /// 1 par session, indicateur Qualiopi 30. Ajouté 12/05/2026.
  SATISFACTION_SESSION
  SUPPORT_PEDAGOGIQUE
  PRE_ACCORD_OPCO
  VALIDATION_OPCO
  FACTURE
  /// BUG-15 — Documents légaux statiques tenant (indic 1 + 9 Qualiopi).
  CGV
  REGLEMENT_INTERIEUR
  CUSTOM
  /// Phase 13 Plan 04 — Export PDF audit veille Qualiopi (VEILLE-03 / critère 6
  /// indicateurs 23/24/25/26). Un PDF par thème, entityType='RegulatoryWatch',
  /// entityId={theme}, persisté en MinIO (D-02), traçable AuditLog
  /// `regulatoryWatch.exported`.
  VEILLE_AUDIT
}

// Référentiel des types de documents Qualiopi (issu de la table Airtable Documents_Qualiopi)
// Ne stocke pas les fichiers — c'est une métadonnée éditoriale qui mappe DocType à un indicateur Qualiopi.
model QualiopiDocCatalog {
  id                String   @id @default(uuid())
  type              DocType  @unique
  name              String // "Convention de formation"
  phase             String // "Pré-formation" | "Formation" | "Post-formation" | "Administratif"
  qualiopiIndicator String? // "Indicateur 7", "Indicateur 30", "Légal Art. L6353-1"
  isMandatory       Boolean  @default(true)
  description       String?
  recommendedDelay  String?
  responsible       String? // "OF", "Apprenant", "OPCO", "Formateur"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DocumentTemplate {
  id        String     @id @default(uuid())
  tenantId  String
  type      DocType
  name      String
  fileUrl   String
  format    String // "docx" | "pdf"
  variables Json
  version   Int        @default(1)
  documents Document[]
}

model Document {
  id                String              @id @default(uuid())
  tenantId          String
  templateId        String?
  template          DocumentTemplate?   @relation(fields: [templateId], references: [id])
  type              DocType
  entityType        String // "session" | "participant" | "invoice"
  entityId          String
  pdfUrl            String
  hashSha256        String
  /// Lot 0 · 0.2 (audit 28/08, E-1) — SHA-256 du JSON des champs d'ENTRÉE
  /// effectivement rendus, posé à la génération. `hashSha256` prouve que le PDF
  /// n'a pas bougé ; celui-ci dit s'il raconte encore la vérité. null = document
  /// antérieur au 02/09/2026 ou type non couvert → verdict « inconnu », jamais
  /// « à jour ». Cf. `apps/web/src/lib/docs/source-fingerprint.ts`.
  sourceFingerprint String?
  status            String              @default("generated")
  sessionId         String?
  session           TrainingSession?    @relation(fields: [sessionId], references: [id])
  participantId     String?
  participant       SessionParticipant? @relation(fields: [participantId], references: [id])
  createdAt         DateTime            @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, type])
}

// =====================================================
// === Email
// =====================================================

model EmailTemplate {
  id        String @id @default(uuid())
  tenantId  String
  code      String @unique
  subject   String
  bodyMjml  String
  variables Json
}

model EmailMessage {
  id            String    @id @default(uuid())
  tenantId      String
  templateId    String?
  fromEmail     String
  toEmails      Json
  subject       String
  bodyHtml      String
  status        String // "queued" | "sent" | "bounced"
  sentAt        DateTime?
  relatedEntity String?
  /// Lot 0 · 0.2 — ids des `Document` réellement partis en pièce jointe.
  /// C'est la seule preuve que l'application possède qu'un document a QUITTÉ
  /// la maison : un document cité ici compte comme ENGAGÉ, on ne le régénère
  /// pas en silence. Les envois antérieurs au 02/09/2026 n'ont pas de ligne du
  /// tout — d'où l'avertissement « ce document a pu être envoyé ».
  documentIds   Json?
  createdAt     DateTime  @default(now())

  @@index([tenantId, sentAt])
}

// =====================================================
// === Référentiel OPCO
// =====================================================

enum OpcoStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Calqué sur la table Airtable "Opco" : référentiel partagé pour ne pas répéter
// les délais / plafonds / docs requis sur chaque Organization.
model OpcoCatalog {
  id                   String         @id @default(uuid())
  code                 String         @unique // "AGEFICE", "OPCO_EP", "ATLAS", "CPF", etc.
  name                 String
  type                 String // "FAF", "OPCO", "Autre"
  website              String?
  contactEmail         String?
  contactPhone         String?
  contactAddress       String?
  averageDelayDays     Int?
  maxAmountPerTraining Decimal?       @db.Decimal(10, 2)
  yearlyCapPerPerson   Decimal?       @db.Decimal(10, 2)
  conditions           String?
  requiredDocs         Json? // string[]
  adminContact         String?
  status               OpcoStatus     @default(ACTIVE)
  internalNotes        String?
  organizations        Organization[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

/// Statut du dossier OPCO envoyé au financeur (AGEFICE, etc.).
/// Pipeline : DRAFT → SENT → APPROVED|REJECTED → REIMBURSED. La timeline
/// 4-étapes existante (`SessionParticipant.opcoApproved/opcoReimbursed`)
/// est synchronisée à partir de ce status.
enum OpcoSubmissionStatus {
  DRAFT // composé mais pas envoyé
  SENT // mail envoyé au financeur
  ACK_RECEIVED // accusé reçu (rare, optionnel)
  APPROVED // accord de prise en charge reçu
  REJECTED // refus
  REIMBURSED // virement reçu — dossier clos
  CANCELED // annulé manuellement par Laurent
}

/// Un dossier complet (CNI+RIB+CFP+Convention+Programme+PDF AGEFICE) envoyé
/// au financeur d'une inscription. 1 SessionParticipant peut avoir plusieurs
/// submissions (resoumission après rejet par exemple).
model OpcoSubmission {
  id                 String               @id @default(uuid())
  tenantId           String
  participantId      String
  participant        SessionParticipant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  // Sponsor = financeur cible (souvent l'AGEFICE local PA)
  sponsorOrgId       String
  sponsorOrg         Organization         @relation(fields: [sponsorOrgId], references: [id])
  status             OpcoSubmissionStatus @default(DRAFT)
  // Email destinataire (resolu au moment de l'envoi : sponsor.emailBilling || sponsor.email)
  recipientEmail     String?
  // Composition mail
  subject            String?
  bodyHtml           String?
  // Pièces jointes : [{ key: MinIO, filename, kind: DocType-like, sizeBytes }]
  attachments        Json
  // Tracking SMTP
  threadId           String? // messageId Nodemailer pour suivi
  sentAt             DateTime?
  ackAt              DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  reimbursedAt       DateTime?
  // Relances auto cron
  reminderCount      Int                  @default(0)
  lastReminderSentAt DateTime?
  // Notes internes (rejet motif, montant accord, etc.)
  internalNotes      String?
  // Audit
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([participantId])
  @@index([sponsorOrgId])
  @@index([status])
  @@index([tenantId, status])
}

// =====================================================
// === Tâches & commentaires (utilitaires CRM)
// =====================================================

enum TaskStatus {
  TODO
  DOING
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Tâches Kanban polymorphes (peuvent être attachées à une session, un lead, une inscription, etc.)
model Task {
  id            String              @id @default(uuid())
  tenantId      String
  title         String
  description   String?
  status        TaskStatus          @default(TODO)
  priority      TaskPriority        @default(MEDIUM)
  ownerUserId   String?
  owner         User?               @relation(fields: [ownerUserId], references: [id])
  dueDate       DateTime?
  // Polymorphisme léger
  sessionId     String?
  session       TrainingSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  leadId        String?
  lead          Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  participantId String?
  participant   SessionParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([tenantId, status, dueDate])
}

// Commentaires internes polymorphes (fil de discussion sur entité)
model InternalComment {
  id             String              @id @default(uuid())
  tenantId       String
  authorUserId   String?
  body           String
  // Polymorphisme léger
  sessionId      String?
  session        TrainingSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  personId       String?
  person         Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  participantId  String?
  participant    SessionParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())

  @@index([tenantId, createdAt])
}

// =====================================================
// === Notifications persistées (Phase 9 — LEAD-01)
// =====================================================

/// Notifications événementielles par-user (vs cloche dérivée tenant-wide
/// dans `server/actions/notifications.ts`).
/// Phase 9 introduit le premier type : 'lead.assigned'. Futurs types possibles :
/// 'session.to_close', 'dossier.incomplete', etc. — schema extensible via `payload Json`.
model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'lead.assigned' (Phase 9), extensible
  payload   Json // typage runtime via packages/shared/src/schemas/lead.ts LeadAssignedPayloadSchema
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, readAt]) // requête cloche
  @@index([tenantId, type, createdAt]) // futurs filtres admin
}

// =====================================================
// === Audit
