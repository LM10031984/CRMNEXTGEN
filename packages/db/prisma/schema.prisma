// =====================================================
// === [Plan additions] — extensions IA / AGEFICE / sync
// =====================================================

model AgeficeProfile {
  id                         String               @id @default(uuid())
  organizationId             String               @unique
  organization               Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // PA AGEFICE rattaché — privilégier la FK vers le référentiel AgeficePointAccueil ;
  // les champs paName/paNumber/paContact/paAddress sont conservés pour compatibilité
  // avec les imports SmartOF (saisie texte libre) et pour override manuel rare.
  pointAccueilId             String?
  pointAccueil               AgeficePointAccueil? @relation(fields: [pointAccueilId], references: [id])
  pointAccueilLockedManually Boolean              @default(false) // true = ne pas réécrire au prochain import
  paName                     String? // "AGEFICE 06"
  paNumber                   String?
  paContact                  String?
  paAddress                  Json?
  paFields                   Json // 54 champs PDF AGEFICE pré-remplis
  pdfTemplateVersion         String               @default("2023-2024")
  // Dernière CFP déclarée (cf attestation URSSAF) — alimente le badge
  // "Budget AGEFICE disponible" sur la fiche apprenant.
  // Règle N-1 → N : CFP exercice 2024 donne des droits utilisables en 2025.
  lastCfpAmount              Float?
  lastCfpYear                Int? // exercice de la CFP (ex: 2024)
  lastCfpEligibleBudget      Int? // 3000 | 600 | 0 — calculé selon montant
  cfpAttestationKey          String? // Attestation CFP scannée en MinIO
  updatedAt                  DateTime             @updatedAt
  createdAt                  DateTime             @default(now())
}

// Pré-inscription publique : un contact reçoit un lien unique, dépose ses pièces,
// l'IA extrait les données, l'admin valide et convertit en Person+Org+LegalLink.
enum PreEnrollmentStatus {
  PENDING_FORM // lien généré, attente du contact
  SUBMITTED // formulaire soumis, fichiers reçus
  EXTRACTING // pipeline IA en cours
  EXTRACTED // données extraites, prêt à valider
  VALIDATED // admin a validé
  CONVERTED // converti en Person + Org + LegalLink + AgeficeProfile
  EXPIRED
  REJECTED
}

model PreEnrollment {
  id                     String              @id @default(uuid())
  tenantId               String
  // Lien public unique
  token                  String              @unique
  expiresAt              DateTime
  // Émission
  sentByUserId           String?
  sentTo                 String? // email contact (info audit)
  sentAt                 DateTime?
  // Identité saisie par le contact
  firstName              String?
  lastName               String?
  email                  String?
  phone                  String?
  birthDate              DateTime?
  birthPlace             String?
  professionalStatus     String? // "Agent commercial" / "Salarié" / "Dirigeant"
  educationLevel         String?
  diploma                String?
  professionalExperience String?
  // Fichiers MinIO (clés relatives au bucket)
  cniKey                 String?
  ribKey                 String?
  cfpKey                 String? // Attestation CFP AGEFICE
  rgpdAcceptedAt         DateTime?
  submittedAt            DateTime?
  // Relances email auto pour les pré-inscriptions PENDING_FORM trop anciennes
  lastReminderSentAt     DateTime?
  reminderCount          Int                 @default(0)
  // Pipeline IA
  status                 PreEnrollmentStatus @default(PENDING_FORM)
  extractedData          Json? // données structurées extraites par l'IA
  aiExtractedAt          DateTime?
  aiModel                String?
  aiPromptVersion        String?
  aiErrorMsg             String?
  // Validation admin
  validatedByUserId      String?
  validatedAt            DateTime?
  rejectionReason        String?
  // Conversion en apprenant
  convertedToPersonId    String?
  convertedToOrgId       String?
  convertedAt            DateTime?
  // Pré-inscription ciblée à une session (optionnel)
  intendedSessionId      String?
  intendedSession        TrainingSession?    @relation(fields: [intendedSessionId], references: [id])
  // Audit
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([tenantId, status])
  @@index([token])
}

// Référentiel officiel des Points d'Accueil AGEFICE en France (438 PA, source : agefice.fr)
model AgeficePointAccueil {
  id             String           @id @default(uuid())
  name           String // "CCI Nice Côte d'Azur"
  address1       String?
  address2       String?
  postalCode     String // "06000" (string padding 5)
  city           String // "NICE"
  department     String // "06" — calculé depuis postalCode (2 chars, 3 pour DOM-TOM 97X/98X)
  departmentName String?
  phone          String? // "04 93 13 75 00"
  email          String?
  website        String?
  contactName    String? // ex: "Virginie BEHIN" — interlocuteur principal du PA pour les dossiers AGEFICE
  numberPta      String? // n° de Point d'Accueil attribué par AGEFICE (ex: "370" pour Nice)
  source         String           @default("agefice.fr-2025") // versioning du référentiel
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  profiles       AgeficeProfile[]

  @@unique([postalCode, name]) // clé naturelle pour upsert idempotent
  @@index([department])
  @@index([city])
}

enum PedagogicalKind {
  ANALYSE_BESOIN
  QCM
  GRILLE_OBS
  COMPETENCES
  DEROULE
  POSITIONNEMENT
  SATISFACTION_CHAUD
  SATISFACTION_FROID
  EMARGEMENT
}

model PedagogicalAsset {
  id            String          @id @default(uuid())
  tenantId      String
  kind          PedagogicalKind
  sessionId     String
  session       TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String?
  rawJson       Json
  pdfUrl        String?
  hashSha256    String?
  generatedAt   DateTime        @default(now())

  @@unique([sessionId, participantId, kind])
  @@index([tenantId, kind])
}

model AIGenerationJob {
  id            String   @id @default(uuid())
  tenantId      String
  provider      String
  model         String
  // Version du prompt utilisé pour cette génération — cf qualiopi-prompts.PROMPT_VERSION.
  // Indispensable pour répondre à un audit Qualiopi qui demanderait
  // "quel prompt a généré le QCM de Mme X le 12/02/2026".
  promptVersion String?
  inputHash     String
  status        String
  retries       Int      @default(0)
  latencyMs     Int?
  errorMsg      String?
  refTable      String
  refId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
  @@index([refTable, refId])
}

model ExternalIdentity {
  id         String   @id @default(uuid())
  tenantId   String
  entityType String
  entityId   String
  source     String // "smartof" | "qualiopi-gen" | "airtable"
  externalId String
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
  @@index([tenantId, entityType, entityId])
}

// =====================================================
// === Pack fin de formation (palier 4) — orchestration BullMQ
// =====================================================

// 5 types de docs générés par le bouton "📦 Pack fin de formation"
// ATTESTATION + CERTIFICAT → écrits dans Document (DocType.ATTESTATION_FIN/CERTIFICAT_REALISATION)
// QCM + GRILLE_OBS + ANALYSE_BESOIN → écrits dans PedagogicalAsset
enum ClosureDocKind {
  ATTESTATION
  CERTIFICAT
  QCM
  GRILLE_OBS
  ANALYSE_BESOIN
  POSITIONNEMENT
  SATISFACTION_CHAUD
  SATISFACTION_FROID
  DEROULE_PEDA
  EMARGEMENT
}

enum ClosureBatchStatus {
  PENDING
  RUNNING
  COMPLETED // tous les jobs ok
  PARTIAL // au moins 1 job en erreur, reste ok
  FAILED // tous les jobs en erreur
}

enum ClosureJobStatus {
  QUEUED
  PROCESSING
  DONE
  ERROR
}

model ClosureBatch {
  id              String             @id @default(uuid())
  tenantId        String
  sessionId       String
  status          ClosureBatchStatus @default(PENDING)
  totalDocs       Int                @default(0)
  doneDocs        Int                @default(0)
  errorDocs       Int                @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdByUserId String?
  jobs            ClosureJob[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([tenantId, sessionId])
  @@index([status])
}

model ClosureJob {
  id                 String           @id @default(uuid())
  batchId            String
  batch              ClosureBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  participantId      String
  kind               ClosureDocKind
  status             ClosureJobStatus @default(QUEUED)
  attempts           Int              @default(0)
  errorMessage       String?
  // Réfs vers le doc produit
  documentId         String? // si kind ∈ {ATTESTATION, CERTIFICAT}
  pedagogicalAssetId String? // si kind ∈ {QCM, GRILLE_OBS, ANALYSE_BESOIN}
  // True si l'IA Ollama a échoué et qu'on a fallback sur stub-content.ts —
  // le PDF est produit (status DONE) mais avec un contenu générique non
  // personnalisé. À régénérer manuellement avant un audit Qualiopi.
  usedStub           Boolean          @default(false)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([batchId, participantId, kind])
  @@index([batchId, status])
}
