{
  "name": "@qualiof/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./product-code": "./scripts/lib/product-code.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "pnpm run db:migrate:local",
    "db:push": "node scripts/db-push-interdit.cjs",
    "db:seed": "pnpm run db:seed:local",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:studio": "pnpm run db:studio:local",
    "db:reset": "pnpm run db:reset:local",
    "import:smartof": "dotenv -e ../../.env -- tsx scripts/import-smartof.ts",
    "import:smartof-sessions": "dotenv -e ../../.env -- tsx scripts/import-smartof-sessions.ts",
    "import:agefice-pa": "dotenv -e ../../.env -- tsx scripts/import-agefice-pa.ts",
    "import:airtable": "dotenv -e ../../.env -- tsx scripts/import-airtable.ts",
    "import:treso": "dotenv -e ../../.env -- tsx scripts/import-treso-agefice.ts",
    "import:veille": "dotenv -e ../../.env -- tsx scripts/import-veille-from-xlsx.ts",
    "backfill:trainer-treso": "dotenv -e ../../.env -- tsx scripts/backfill-trainer-from-treso.ts",
    "lint": "tsc --noEmit",
    "test": "dotenv -e ../../.env.local -e ../../.env -- vitest run",
    "import:agefice-pta": "dotenv -e ../../.env -- tsx scripts/import-agefice-pta-officiel.ts",
    "import:diag-catalog": "dotenv -e ../../.env -- tsx scripts/import-diag-catalog.ts",
    "extract:drive-catalog": "tsx scripts/extract-drive-catalog.ts",
    "import:drive-catalog": "dotenv -e ../../.env -- tsx scripts/import-drive-catalog.ts",
    "import:drive-catalog:local": "dotenv -e ../../.env.local -e ../../.env -- tsx scripts/import-drive-catalog.ts",
    "db:migrate:local": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate dev",
    "db:deploy:local": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate deploy",
    "db:seed:local": "dotenv -e ../../.env.local -e ../../.env -- tsx prisma/seed.ts",
    "db:studio:local": "dotenv -e ../../.env.local -e ../../.env -- prisma studio",
    "import:diag-catalog:local": "dotenv -e ../../.env.local -e ../../.env -- tsx scripts/import-diag-catalog.ts",
    "check:schema": "tsx scripts/check-migrations-match-schema.ts",
    "guard:local": "dotenv -e ../../.env.local -e ../../.env -- tsx scripts/assert-db-target.ts",
    "guard:prod": "dotenv -e ../../.env -- tsx scripts/assert-db-target.ts",
    "db:reset:local": "pnpm run guard:local && dotenv -e ../../.env.local -e ../../.env -- prisma migrate reset",
    "db:deploy:prod": "pnpm run guard:prod && dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed:prod": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio:prod": "pnpm run guard:prod && dotenv -e ../../.env -- prisma studio",
    "db:query:prod": "dotenv -e ../../.env -- tsx scripts/run-readonly-sql.ts",
    "fix:depublier-coquilles": "dotenv -e ../../.env -- tsx scripts/fix-depublier-coquilles-import.ts",
    "fix:accessibilite-frm": "dotenv -e ../../.env -- tsx scripts/fix-accessibilite-tronquee-frm.ts",
    "db:query:local": "dotenv -e ../../.env.local -e ../../.env -- tsx scripts/run-readonly-sql.ts",
    "fix:d19ter-prod-00661": "dotenv -e ../../.env -- tsx scripts/fix-d19ter-prod-00661.ts",
    "seed:demo-signature": "dotenv -e ../../.env.local -e ../../.env -- tsx scripts/seed-demo-signature.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "5.22.0",
    "@prisma/client": "^5.22.0",
    "@qualiof/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "pg": "8.13.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "argon2": "^0.41.1",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
