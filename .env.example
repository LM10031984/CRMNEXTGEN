# ===========================================
# QualiOF — Variables d'environnement
# Copier en .env et remplir les blancs.
# ===========================================

# === Node env ===
NODE_ENV="development"

# === Database ===
DATABASE_URL="postgresql://qualiof:qualiof_dev@localhost:5432/qualiof?schema=public"

# === Redis (queue BullMQ) ===
REDIS_URL="redis://localhost:6379"

# === MinIO (stockage S3-compatible des documents) ===
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="qualiof"
S3_SECRET_KEY="qualiof_dev_minio"
S3_BUCKET_DOCS="qualiof-docs"
S3_BUCKET_TEMPLATES="qualiof-templates"
S3_FORCE_PATH_STYLE="true"

# === Gotenberg (DOCX → PDF) ===
GOTENBERG_URL="http://localhost:3001"

# === Doc Engine (microservice Python à créer en palier 3) ===
DOC_ENGINE_URL="http://localhost:5000"

# ============================================
# === IA (gateway entre Ollama dev / Claude prod) ===
# ============================================

# Provider par défaut : "ollama" en dev, "anthropic" en prod
AI_PROVIDER="ollama"

# Ollama (dev local sur Mac M-series)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# Anthropic Claude (prod)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"

# OpenAI (fallback optionnel)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ============================================
# === Briques externes (outils Laurent) ===
# ============================================

# Outil questionnaires existant (à exposer en HTTP local)
QUESTIONNAIRE_SERVICE_URL=""

# Outil certificats existant
CERTIFICAT_SERVICE_URL=""

# ============================================
# === Email (SMTP) ===
# ============================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="QualiOF <noreply@startacademy.fr>"

# Provider alternatif Resend (optionnel)
RESEND_API_KEY=""

# ============================================
# === Auth (Lucia) ===
# ============================================
# Générer avec : openssl rand -hex 32
AUTH_SECRET=""

# Durée session (secondes)
SESSION_LIFETIME="2592000"  # 30 jours

# ============================================
# === App ===
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="QualiOF"
TENANT_DEFAULT_NAME="Start Academy"
TENANT_DEFAULT_NUM_DA=""
TENANT_DEFAULT_SIRET=""

# ============================================
# === Signature électronique (palier futur) ===
# ============================================
YOUSIGN_API_KEY=""
YOUSIGN_BASE_URL="https://api-sandbox.yousign.app/v3"

# ============================================
# === Logs / Monitoring ===
# ============================================
LOG_LEVEL="debug"
