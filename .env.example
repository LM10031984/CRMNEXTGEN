# ===========================================
# QualiOF — Variables d'environnement
# Copier en .env et remplir les blancs.
# ===========================================

# === Node env ===
NODE_ENV="development"

# === Database ===
# Dev local (Docker) : DATABASE_URL = DIRECT_URL (pas de pooler, no-op).
# Cloud Supabase (Phase 19) : les 2 URLs DIFFÈRENT via le pooler Supavisor —
#   - DATABASE_URL  = transaction pooler :6543 avec ?pgbouncer=true&connection_limit=1 (runtime app)
#     Ex: postgresql://postgres.<ref>:<PASSWORD>@aws-<N>-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   - DIRECT_URL    = session pooler :5432 SANS pgbouncer (prisma migrate deploy — prepared statements requis)
#     Ex: postgresql://postgres.<ref>:<PASSWORD>@aws-<N>-<region>.pooler.supabase.com:5432/postgres
#   Le préfixe aws-<N> est PROJECT-SPECIFIC (lu au dashboard, jamais deviné). NE PAS utiliser db.<ref>.supabase.co (IPv6-only).
DATABASE_URL="postgresql://qualiof:qualiof_dev@localhost:5432/qualiof?schema=public"

# === Cloud v6 (Phase 17) — Supabase Postgres + Storage ===
# DIRECT_URL : connexion directe Prisma (migrate deploy). En dev local = DATABASE_URL (no-op).
DIRECT_URL="postgresql://qualiof:qualiof_dev@localhost:5432/qualiof?schema=public"
# STORAGE_PROVIDER : 'minio' (défaut local) | 'supabase' (cloud, Phase 18)
STORAGE_PROVIDER="minio"
# SUPABASE_* : requis SEULEMENT si STORAGE_PROVIDER=supabase
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Supabase Storage — clés CLIENT (upload direct-to-storage, publiables)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === MinIO (stockage S3-compatible des documents) ===
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="qualiof"
S3_SECRET_KEY="qualiof_dev_minio"
S3_BUCKET_DOCS="qualiof-docs"
S3_BUCKET_TEMPLATES="qualiof-templates"
S3_FORCE_PATH_STYLE="true"

# === Gotenberg (DOCX → PDF) ===
# Dev local : Docker localhost:3001. Prod (Phase 20) : le worker joint le proxy
# Caddy en interne (http://gotenberg-proxy.railway.internal:8080) ; Vercel (Phase 21)
# via le domaine PUBLIC du proxy. Gotenberg lui-même reste privé (gotenberg.railway.internal:3000).
GOTENBERG_URL="http://localhost:3001"

# === WeasyPrint (moteur PDF secondaire réel, remplace l'alias mort du palier 3) ===
# Dev local : localhost:5001. Prod (Phase 20) : worker en interne
# (http://weasyprint.railway.internal:5001) ; Vercel (Phase 21) via domaine public.
WEASYPRINT_URL="http://localhost:5001"
# Bearer partagé worker/proxy-Gotenberg/WeasyPrint (câblé Phase 17, enforcé server-side Phase 20).
# MÊME valeur sur les 3 services Railway. Générer : openssl rand -hex 32.
DOC_ENGINE_TOKEN=""

# === Workers de fond (3ᵉ hôte cloud, Phase 20) — recalibrage cloud surchargeable ===
# Défauts encodés dans ecosystem.config.cjs (pm2). Sous pooler Supabase
# (connection_limit=1) : garder concurrency ~3, ne PAS monter agressivement.
# Non requis en dev local (les workers ont leurs propres défauts).
QUEUE_CONCURRENCY="3"          # closure : jobs closure traités en parallèle
QUEUE_POLL_INTERVAL_MS="3000"  # closure : intervalle de poll ClosureJob (SKIP LOCKED)
OCR_CONCURRENCY="2"            # ocr : pré-inscriptions rasterisées/vision en parallèle
OCR_POLL_INTERVAL_MS="5000"   # ocr : intervalle de poll PreEnrollment SUBMITTED

# ============================================
# === IA — Local-first via Ollama (M5 Pro 64Go) ===
# ============================================

# Provider par défaut. Options : "ollama" | "openrouter" | "anthropic" | "qualiopi-gen"
# openrouter pour basculer sur Claude cloud (milestone v6, via gateway OpenRouter).
AI_PROVIDER="ollama"

# Ollama natif (brew install ollama). Modèles déjà téléchargés sur la machine.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL_FAST="mistral-small:24b"
OLLAMA_MODEL_REASONING="qwen3:30b-a3b"
OLLAMA_MODEL_EMBED="nomic-embed-text:latest"
OLLAMA_MODEL_VISION="llama3.2-vision:11b"  # OCR images CNI/RIB (photos apprenants) — qwen2.5vl:7b plante sur Ollama 0.21+ (compute graph aberrant)

# Anthropic Claude (fallback, optionnel)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-7"

# --- OpenRouter (cloud Claude via gateway, milestone v6) ---
# OPENROUTER_API_KEY est REQUISE si AI_PROVIDER=openrouter (obtenue sur openrouter.ai).
# Sinon le boot passe (clé optionnelle) mais llm-client throw au 1er appel cloud.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL_FAST="anthropic/claude-haiku-4.5"       # docs volume rapides (QCM, Analyse besoin, Positionnement, Satisfaction)
OPENROUTER_MODEL_QUALITY="anthropic/claude-sonnet-4.6"   # docs critiques audit (Programme, Déroulé pédagogique)
OPENROUTER_MODEL_VISION="anthropic/claude-haiku-4.5"     # OCR images (CNI, RIB, factures)
OPENROUTER_APP_NAME="QualiOF"                            # header X-Title (tracking OpenRouter)
OPENROUTER_SITE_URL="http://localhost:3010"              # header HTTP-Referer (leaderboard OpenRouter)

# ============================================
# === Qualiopi Gen (Supabase Edge Functions) ===
# ============================================
# Service IA pédagogique externe (analyse besoin, QCM, grille obs, déroulé, compétences)
# Projet Supabase : vgyxuuryaslqevkpvkjk
QUALIOPI_GEN_URL="https://vgyxuuryaslqevkpvkjk.supabase.co/functions/v1"
QUALIOPI_GEN_TOKEN=""

# ============================================
# === Email (SMTP) ===
# Prod (Phase 20) : OVH ssl0.ovh.net:465 SMTP_SECURE=true. L'egress :465 depuis
# Railway n'est débloqué QUE sur le plan Pro (relances factures) — cf 20-DEPLOY.md.
# ============================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="QualiOF <noreply@startacademy.fr>"

# Provider alternatif Resend (optionnel)
RESEND_API_KEY=""

# ============================================
# === Auth (Lucia) ===
# ============================================
# Générer avec : openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_openssl_rand_hex_32_______________"

# Durée session (secondes)
SESSION_LIFETIME="2592000"  # 30 jours

# ============================================
# === App ===
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="QualiOF"

# Environnement applicatif (v6 Phase 21) — development | staging | production
# staging = filigrane PDF + bandeau UI + gardes sorties (calendar skip, MAIL_DRY_RUN)
NEXT_PUBLIC_APP_ENV=development
# Force le dry-run mail même si SMTP_HOST est renseigné (garde staging D-02)
MAIL_DRY_RUN=false

# URL absolue de l'application (Phase 9 — utilisee par les emails 'lead.assigned'
# pour construire les liens "Voir le lead"). Si vide, fallback NEXT_PUBLIC_APP_URL
# puis '' (liens relatifs — fonctionnels mais peu lisibles dans les clients mail).
APP_URL="http://localhost:3002"
TENANT_DEFAULT_NAME="Start Academy"
TENANT_DEFAULT_NUM_DA=""
TENANT_DEFAULT_SIRET=""

# ============================================
# === Identité de l'OF (organisme de formation) ===
# Utilisé dans les PDF générés (AGEFICE, programme, attestations, factures)
# ----------------------------------------------------------------------------
# Phase 7 (2026-05-15) : Ces variables OF_* sont desormais FALLBACK SECONDAIRE.
#   Si vous avez renseigne les valeurs dans /app/parametres (UI), la BDD prend
#   le pas. Les ENV ci-dessous restent utiles comme valeurs initiales avant
#   la premiere sauvegarde UI (D-01 hybrid BDD-fallback-ENV).
# ----------------------------------------------------------------------------
# ============================================
OF_NAME="START ACADEMY"
OF_SIRET="95131909400011"
OF_RNQ="93 06 10481 06"             # numéro de déclaration d'activité (NDA)
OF_ADDRESS_STREET="618 bd Jean Maurel inférieur"
OF_ADDRESS_CP="06140"
OF_ADDRESS_VILLE="Vence"
OF_PHONE="0631056390"
OF_EMAIL="formation@start-academy.fr"
OF_TVA_INTRA=""                     # vide = exonération art. 293 B CGI
OF_IBAN=""
OF_BIC=""

# Responsable OF (signataire des conventions / Resp. dans le formulaire AGEFICE)
OF_RESP_CIVILITE="MR"               # MR | MME
OF_RESP_NOM="MARX"
OF_RESP_PRENOM="Laurent"
OF_RESP_TITRE="PDG"                 # affiché sous la signature dans les PDF
OF_RESP_PHONE=""                    # vide = OF_PHONE
OF_RESP_EMAIL=""                    # vide = OF_EMAIL

# Contact OF (interlocuteur jour-le-jour) — vide = mêmes valeurs que Resp
OF_CONTACT_CIVILITE=""
OF_CONTACT_NOM=""
OF_CONTACT_PRENOM=""
OF_CONTACT_PHONE=""
OF_CONTACT_EMAIL=""

# ============================================
# === Signature électronique (palier futur) ===
# ============================================
YOUSIGN_API_KEY=""
YOUSIGN_BASE_URL="https://api-sandbox.yousign.app/v3"

# ============================================
# === Logs / Monitoring ===
# ============================================
LOG_LEVEL="debug"
