# ===========================================
# QualiOF — Variables d'environnement
# Copier en .env et remplir les blancs.
# ===========================================

# === Node env ===
NODE_ENV="development"

# === Database ===
DATABASE_URL="postgresql://qualiof:qualiof_dev@localhost:5432/qualiof?schema=public"

# === Redis (queue BullMQ) ===
REDIS_URL="redis://localhost:6379"

# === MinIO (stockage S3-compatible des documents) ===
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="qualiof"
S3_SECRET_KEY="qualiof_dev_minio"
S3_BUCKET_DOCS="qualiof-docs"
S3_BUCKET_TEMPLATES="qualiof-templates"
S3_FORCE_PATH_STYLE="true"

# === Gotenberg (DOCX → PDF) ===
GOTENBERG_URL="http://localhost:3001"

# === Doc Engine (microservice Python à créer en palier 3) ===
DOC_ENGINE_URL="http://localhost:5000"

# ============================================
# === IA — Local-first via Ollama (M5 Pro 64Go) ===
# ============================================

# Provider par défaut. Options : "ollama" | "anthropic" | "qualiopi-gen"
AI_PROVIDER="ollama"

# Ollama natif (brew install ollama). Modèles déjà téléchargés sur la machine.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL_FAST="mistral-small:24b"
OLLAMA_MODEL_REASONING="qwen3:30b-a3b"
OLLAMA_MODEL_EMBED="nomic-embed-text:latest"

# Anthropic Claude (fallback, optionnel)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-7"

# ============================================
# === Qualiopi Gen (Supabase Edge Functions) ===
# ============================================
# Service IA pédagogique externe (analyse besoin, QCM, grille obs, déroulé, compétences)
# Projet Supabase : vgyxuuryaslqevkpvkjk
QUALIOPI_GEN_URL="https://vgyxuuryaslqevkpvkjk.supabase.co/functions/v1"
QUALIOPI_GEN_TOKEN=""

# ============================================
# === Email (SMTP) ===
# ============================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="QualiOF <noreply@startacademy.fr>"

# Provider alternatif Resend (optionnel)
RESEND_API_KEY=""

# ============================================
# === Auth (Lucia) ===
# ============================================
# Générer avec : openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_openssl_rand_hex_32_______________"

# Durée session (secondes)
SESSION_LIFETIME="2592000"  # 30 jours

# ============================================
# === App ===
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="QualiOF"
TENANT_DEFAULT_NAME="Start Academy"
TENANT_DEFAULT_NUM_DA=""
TENANT_DEFAULT_SIRET=""

# ============================================
# === Identité de l'OF (organisme de formation) ===
# Utilisé dans les PDF générés (AGEFICE, programme, attestations, factures)
# ============================================
OF_NAME="START ACADEMY"
OF_SIRET="95131909400011"
OF_RNQ="93 06 10481 06"             # numéro de déclaration d'activité (NDA)
OF_ADDRESS_STREET="618 bd Jean Maurel inférieur"
OF_ADDRESS_CP="06140"
OF_ADDRESS_VILLE="Vence"
OF_PHONE="0631056390"
OF_EMAIL="formation@start-academy.fr"
OF_TVA_INTRA=""                     # vide = exonération art. 293 B CGI
OF_IBAN=""
OF_BIC=""

# Responsable OF (signataire des conventions / Resp. dans le formulaire AGEFICE)
OF_RESP_CIVILITE="MR"               # MR | MME
OF_RESP_NOM="MARX"
OF_RESP_PRENOM="Laurent"
OF_RESP_TITRE="PDG"                 # affiché sous la signature dans les PDF
OF_RESP_PHONE=""                    # vide = OF_PHONE
OF_RESP_EMAIL=""                    # vide = OF_EMAIL

# Contact OF (interlocuteur jour-le-jour) — vide = mêmes valeurs que Resp
OF_CONTACT_CIVILITE=""
OF_CONTACT_NOM=""
OF_CONTACT_PRENOM=""
OF_CONTACT_PHONE=""
OF_CONTACT_EMAIL=""

# ============================================
# === Signature électronique (palier futur) ===
# ============================================
YOUSIGN_API_KEY=""
YOUSIGN_BASE_URL="https://api-sandbox.yousign.app/v3"

# ============================================
# === Logs / Monitoring ===
# ============================================
LOG_LEVEL="debug"
