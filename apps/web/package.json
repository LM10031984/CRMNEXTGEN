{
  "name": "@qualiof/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:full": "concurrently -n next,worker -c blue,magenta -k \"pnpm dev\" \"pnpm worker:closure\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "worker:closure": "dotenv -e ../../.env -- tsx scripts/closure-worker.ts",
    "smoke:closure": "dotenv -e ../../.env -- tsx scripts/closure-smoke-test.ts",
    "dump:closure": "dotenv -e ../../.env -- tsx scripts/closure-dump-pdfs.ts",
    "bench:closure": "dotenv -e ../../.env -- tsx scripts/closure-bench-ollama.ts",
    "e2e:closure": "dotenv -e ../../.env -- tsx scripts/closure-e2e-test.ts"
  },
  "//": "Le .env est lu depuis la racine du monorepo via next.config.mjs (loadEnv).",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@hookform/resolvers": "^3.9.1",
    "@qualiof/db": "workspace:*",
    "@qualiof/shared": "workspace:*",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "archiver": "^7.0.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.76.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.10.1",
    "lucia": "^3.2.2",
    "lucide-react": "^0.471.0",
    "marked": "^18.0.2",
    "next": "^14.2.21",
    "oslo": "^1.2.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@lucia-auth/adapter-prisma": "^4.0.1",
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^14.2.21",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
